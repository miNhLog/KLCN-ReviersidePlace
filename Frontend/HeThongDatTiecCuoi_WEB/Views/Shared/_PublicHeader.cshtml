@{
    var activePage = ViewData["PublicActivePage"] as string ?? string.Empty;
}
<header class="home-header">
    <div class="home-container header-inner">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Riverside Palace - Trang chủ"><span class="brand-mark" aria-hidden="true">✧</span><span class="brand-name">Riverside Palace</span></a>
        <nav class="desktop-nav" aria-label="Điều hướng chính">
            <a class="@(activePage == "home" ? "active" : null)" asp-controller="Home" asp-action="Index" aria-current="@(activePage == "home" ? "page" : null)">Trang chủ</a>
            <a class="@(activePage == "halls" ? "active" : null)" asp-controller="Halls" asp-action="Index" aria-current="@(activePage == "halls" ? "page" : null)">Sảnh tiệc</a>
            <a href="#" data-coming-soon>Thực đơn</a><a href="#" data-coming-soon>Gói trang trí</a>
            <button type="button" data-open-ai>Tư vấn AI</button><a href="#" data-coming-soon>Tiệc của tôi</a>
        </nav>
        <div class="header-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <details class="account-menu">
                    <summary><span class="material-symbols-outlined" aria-hidden="true">person</span><span>Xin chào, @User.Identity.Name</span><span class="material-symbols-outlined account-chevron" aria-hidden="true">expand_more</span></summary>
                    <div class="account-dropdown"><a href="#" data-coming-soon>Tiệc của tôi</a><form asp-controller="Auth" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form></div>
                </details>
            }
            else
            {
                <a class="login-link" asp-controller="Auth" asp-action="Login">Đăng nhập / Đăng ký</a>
                <span class="header-avatar material-symbols-outlined" aria-hidden="true">person</span>
            }
            <button class="mobile-menu-toggle" type="button" aria-label="Mở menu" aria-controls="mobileNavigation" aria-expanded="false"><span class="material-symbols-outlined" aria-hidden="true">menu</span></button>
        </div>
    </div>
    <nav class="mobile-nav" id="mobileNavigation" aria-label="Điều hướng di động" hidden>
        <a asp-controller="Home" asp-action="Index" aria-current="@(activePage == "home" ? "page" : null)">Trang chủ</a><a asp-controller="Halls" asp-action="Index" aria-current="@(activePage == "halls" ? "page" : null)">Sảnh tiệc</a><a href="#" data-coming-soon>Thực đơn</a><a href="#" data-coming-soon>Gói trang trí</a><button type="button" data-open-ai>Tư vấn AI</button><a href="#" data-coming-soon>Tiệc của tôi</a>
    </nav>
</header>
<div class="mobile-nav-backdrop" hidden></div>
