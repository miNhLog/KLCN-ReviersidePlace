@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var displayName = User.Identity?.Name ?? "Tài khoản quản trị";
    var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Người dùng";
    var nameParts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0
        ? "RP"
        : string.Concat(nameParts.Take(2).Select(part => char.ToUpperInvariant(part[0])));

    bool IsActive(string controller, string action = "Index") =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IRevirsidePlace</title>

    <script>
        try {
            if (localStorage.getItem("sidebarState") === "collapsed") {
                document.documentElement.classList.add("sidebar-is-collapsed");
            }
        } catch (error) {
            // Sidebar vẫn dùng trạng thái mặc định nếu trình duyệt chặn localStorage.
        }
    </script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet"
          href="~/css/admin-hall.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin-sidebar.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-layout">
        <button type="button"
                class="mobile-sidebar-toggle"
                id="mobileSidebarToggle"
                aria-controls="adminSidebar"
                aria-expanded="false"
                aria-label="Mở thanh điều hướng">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <aside class="sidebar admin-sidebar" id="adminSidebar" aria-label="Điều hướng quản trị">
            <header class="sidebar-header">
                <a asp-controller="AdminHall"
                   asp-action="Index"
                   class="sidebar-brand"
                   aria-label="IRevirsidePlace - Trang quản trị">
                    <span class="brand-icon" aria-hidden="true">
                        <i class="fa-solid fa-crown"></i>
                    </span>
                    <span class="brand-text">
                        <strong>IRevirsidePlace</strong>
                        <small>Hệ thống quản trị</small>
                    </span>
                </a>

                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        aria-controls="adminSidebar"
                        aria-expanded="true"
                        aria-label="Thu gọn thanh điều hướng"
                        title="Thu gọn thanh điều hướng">
                    <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
                </button>
            </header>

            <div class="sidebar-content">
                <section class="sidebar-section" aria-labelledby="operationsMenuTitle">
                    <h2 class="sidebar-section-title" id="operationsMenuTitle">Quản lý vận hành</h2>
                    <nav class="sidebar-menu" aria-label="Quản lý vận hành">
                        <a asp-controller="AdminHall"
                           asp-action="Index"
                           class="sidebar-item @(IsActive("AdminHall") ? "active" : string.Empty)"
                           aria-current="@(IsActive("AdminHall") ? "page" : null)"
                           data-sidebar-tooltip="Quản lý Sảnh & Lịch">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-building"></i>
                            </span>
                            <span class="sidebar-label">Quản lý Sảnh &amp; Lịch</span>
                        </a>

                        <a asp-controller="AdminDecorService"
                           asp-action="Index"
                           class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminDecorService" ? "active" : "")"
                           data-sidebar-tooltip="Gói Decor & Dịch vụ">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </span>
                            <span class="sidebar-label">Gói Decor &amp; Dịch vụ</span>
                        </a>

                        <a asp-controller="AdminPricingPolicy"
                           asp-action="Index"
                           class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminPricingPolicy" ? "active" : "")"
                           data-sidebar-tooltip="Bảng giá & Chính sách">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-sliders"></i>
                            </span>
                            <span class="sidebar-label">Bảng giá &amp; Chính sách</span>
                        </a>
                    </nav>
                </section>

                <section class="sidebar-section" aria-labelledby="catalogMenuTitle">
                    <h2 class="sidebar-section-title" id="catalogMenuTitle">Danh mục</h2>
                    <nav class="sidebar-menu" aria-label="Danh mục">
                        <a asp-controller="AdminMenu"
                           asp-action="Index"
                           class="sidebar-item @(IsActive("AdminMenu") ? "active" : string.Empty)"
                           aria-current="@(IsActive("AdminMenu") ? "page" : null)"
                           data-sidebar-tooltip="Thực đơn & Ẩm thực">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-utensils"></i>
                            </span>
                            <span class="sidebar-label">Thực đơn &amp; Ẩm thực</span>
                        </a>
                    </nav>
                </section>

                <section class="sidebar-section" aria-labelledby="monitoringMenuTitle">
                    <h2 class="sidebar-section-title" id="monitoringMenuTitle">Nghiệp vụ &amp; giám sát</h2>
                    <nav class="sidebar-menu" aria-label="Nghiệp vụ và giám sát">
                        <a asp-controller="AdminReport"
                           asp-action="Index"
                           class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminReport" ? "active" : "")"
                           data-sidebar-tooltip="Báo cáo doanh thu & BI">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-chart-line"></i>
                            </span>
                            <span class="sidebar-label">Báo cáo doanh thu &amp; BI</span>
                        </a>

                        <a asp-controller="AdminBooking"
                           asp-action="Index"
                           class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminBooking" ? "active" : "")"
                           data-sidebar-tooltip="Quản lý đặt tiệc &amp; hợp đồng">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-file-contract"></i>
                            </span>
                            <span class="sidebar-label">Đặt tiệc &amp; hợp đồng</span>
                        </a>
                    </nav>
                </section>


                <section class="sidebar-section" aria-labelledby="systemMenuTitle">
                    <h2 class="sidebar-section-title" id="systemMenuTitle">Quản lý hệ thống</h2>
                    <nav class="sidebar-menu" aria-label="Quản lý hệ thống">
                        <a asp-controller="AdminAccount"
                           asp-action="Index"
                           class="sidebar-item @(IsActive("AdminAccount") ? "active" : string.Empty)"
                           aria-current="@(IsActive("AdminAccount") ? "page" : null)"
                           data-sidebar-tooltip="Phân quyền tài khoản">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-users"></i>
                            </span>
                            <span class="sidebar-label">Phân quyền tài khoản</span>
                        </a>

                        <button type="button"
                                class="sidebar-item developing"
                                data-sidebar-tooltip="Lịch sử kiểm toán">
                            <span class="sidebar-icon" aria-hidden="true">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </span>
                            <span class="sidebar-label">Lịch sử kiểm toán</span>
                        </button>
                    </nav>
                </section>
            </div>

            <footer class="sidebar-footer"
                    data-sidebar-tooltip="@displayName · @roleName">
                <div class="sidebar-account">
                    <div class="avatar" aria-hidden="true">@initials</div>
                    <div class="user-info">
                        <strong>@displayName</strong>
                        <span>@roleName</span>
                    </div>
                </div>

                <form method="post" action="/dang-xuat" class="sidebar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="logout-button"
                            aria-label="Đăng xuất"
                            title="Đăng xuất">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                    </button>
                </form>
            </footer>
        </aside>

        <main class="main-content" id="adminMainContent">
            @RenderBody()
        </main>
    </div>

    <div class="sidebar-tooltip" id="sidebarTooltip" role="tooltip"></div>
    <div class="sidebar-toast" id="globalToast" role="status" aria-live="polite">
        Chức năng đang phát triển
    </div>

    <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
