@model HeThongDatTiecCuoi_WEB.Models.Auth.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<main class="auth-page"><section class="auth-card">
<h1>Đổi mật khẩu</h1>
<p>Đây là lần đăng nhập đầu tiên. Vui lòng đặt mật khẩu riêng của bạn để tiếp tục.</p>
<div asp-validation-summary="ModelOnly" class="field-error"></div>
<form asp-action="ChangePassword" method="post">
 @Html.AntiForgeryToken()
 <label>Mật khẩu ban đầu</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
 <label>Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" required />
 <label>Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
 <button type="submit">Lưu mật khẩu mới</button>
</form></section></main>
