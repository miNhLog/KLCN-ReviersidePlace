            <div class="divider"><span>HOẶC TIẾP TỤC VỚI</span></div>
            @if (!string.IsNullOrWhiteSpace(googleClientId))
            {
                <div id="g_id_onload"
                     data-client_id="@googleClientId"
                     data-context="signin"
                     data-ux_mode="popup"
                     data-callback="handleGoogleCredentialResponse"
                     data-auto_prompt="false">
                </div>
                <div class="google-signin-host">
                    <div class="g_id_signin"
                         data-type="standard"
                         data-shape="rectangular"
                         data-theme="outline"
                         data-text="signin_with"
                         data-size="large"
                         data-logo_alignment="left"
                         data-width="400">
                    </div>
                </div>
                <form id="googleAuthForm" asp-action="Google" asp-controller="Auth" method="post" class="google-auth-form">
                    <input id="googleCredential" name="Credential" type="hidden" />
                    <input id="googleRememberMe" name="RememberMe" type="hidden" value="false" />
                    <input name="ReturnUrl" type="hidden" value="@Model.ReturnUrl" />
                </form>
            }
            else
            {
                <button class="google-button" type="button" disabled title="Thiếu cấu hình GoogleAuth:ClientId"><b>G</b> Chưa cấu hình Google Login</button>
            }
            <p class="switch-page">Chưa có tài khoản? <a asp-action="Register">Đăng ký tài khoản mới ngay</a></p>
            <footer>Hotline hỗ trợ: <strong>0933 777 888</strong> <span>│</span> 360D Bến Vân Đồn, P.1, Q.4, TP.HCM</footer>
        </div>
    </section>
</main>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(googleClientId))
    {
        <script src="https://accounts.google.com/gsi/client" async defer></script>
    }
}
