@section Scripts {

    <script>

        // =====================================================
        // MODAL
        // =====================================================

        function openFoodModal(id) {

            const modal =
                document.getElementById(id);

            if (modal) {
                modal.classList.add("show");
            }

        }


        function closeFoodModal(modal) {

            if (modal) {
                modal.classList.remove("show");
            }

        }


        document
            .querySelectorAll("[data-open-modal]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        openFoodModal(
                            button.dataset.openModal
                        );

                    }
                );

            });


        document
            .querySelectorAll("[data-close-modal]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeFoodModal(
                            button.closest(".food-modal")
                        );

                    }
                );

            });


        document
            .querySelectorAll(".food-modal")
            .forEach(function (modal) {

                modal.addEventListener(
                    "click",
                    function (event) {

                        if (event.target === modal) {

                            closeFoodModal(modal);

                        }

                    }
                );

            });


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    document
                        .querySelectorAll(
                            ".food-modal.show"
                        )
                        .forEach(
                            function (modal) {

                                closeFoodModal(modal);

                            }
                        );

                }

            }
        );


        // =====================================================
        // EDIT MENU
        // =====================================================

        document
            .querySelectorAll(
                ".edit-menu-button"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        document.getElementById(
                            "editMenuId"
                        ).value =
                            button.dataset.id;


                        document.getElementById(
                            "editMenuName"
                        ).value =
                            button.dataset.ten ?? "";


                        document.getElementById(
                            "editMenuDescription"
                        ).value =
                            button.dataset.mota ?? "";


                        document.getElementById(
                            "editMenuPrice"
                        ).value =
                            button.dataset.gia ?? "0";


                        openFoodModal(
                            "editMenuModal"
                        );

                    }
                );

            });


        // =====================================================
        // EDIT DISH
        // =====================================================

        document
            .querySelectorAll(
                ".edit-dish-button"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        document.getElementById(
                            "editDishId"
                        ).value =
                            button.dataset.id;


                        document.getElementById(
                            "editDishName"
                        ).value =
                            button.dataset.ten ?? "";


                        document.getElementById(
                            "editDishGroup"
                        ).value =
                            button.dataset.nhom
                            ?? "Món chính";


                        document.getElementById(
                            "deleteDishImage"
                        ).checked =
                            false;


                        document.getElementById(
                            "deleteImageWrapper"
                        ).style.display =
                            button.dataset.hinhanh
                                ? "flex"
                                : "none";


                        openFoodModal(
                            "editDishModal"
                        );

                    }
                );

            });


        // =====================================================
        // REORDER DISH
        // =====================================================

        function getCompositionIds() {

            return Array.from(
                document.querySelectorAll(
                    "#compositionList .food-composition-item"
                )
            ).map(
                function (row) {

                    return Number(
                        row.dataset.monId
                    );

                }
            );

        }


        document
            .querySelectorAll(".move-dish")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const ids =
                            getCompositionIds();


                        const index =
                            Number(
                                button.dataset.index
                            );


                        const targetIndex =
                            button.dataset.direction
                            === "up"
                                ? index - 1
                                : index + 1;


                        if (
                            targetIndex < 0 ||
                            targetIndex >= ids.length
                        ) {
                            return;
                        }


                        const temp =
                            ids[index];


                        ids[index] =
                            ids[targetIndex];


                        ids[targetIndex] =
                            temp;


                        document.getElementById(
                            "reorderIds"
                        ).value =
                            ids.join(",");


                        document.getElementById(
                            "reorderForm"
                        ).submit();

                    }
                );

            });

                    // =====================================================
        // GIỮ NGUYÊN VỊ TRÍ CUỘN SAU KHI THAO TÁC
        // =====================================================

        const foodScrollKey = "adminThucDonScrollPosition";


        function saveFoodScrollPosition() {

            sessionStorage.setItem(
                foodScrollKey,
                window.scrollY.toString()
            );

        }


        // Lưu vị trí khi submit các form trong trang thực đơn
        document
            .querySelectorAll(
                ".food-page form, .food-modal form"
            )
            .forEach(function (form) {

                form.addEventListener(
                    "submit",
                    saveFoodScrollPosition
                );

            });


        // Lưu vị trí khi click các link lọc / xem chi tiết
        document
            .querySelectorAll(
                ".food-page a[href]"
            )
            .forEach(function (link) {

                link.addEventListener(
                    "click",
                    saveFoodScrollPosition
                );

            });


        // Sau khi trang load lại,
        // đưa màn hình về đúng vị trí trước đó
        window.addEventListener(
            "pageshow",
            function () {

                const savedPosition =
                    sessionStorage.getItem(
                        foodScrollKey
                    );

                if (savedPosition === null) {
                    return;
                }

                setTimeout(
                    function () {

                        window.scrollTo({
                            top: Number(savedPosition),
                            left: 0,
                            behavior: "auto"
                        });

                        sessionStorage.removeItem(
                            foodScrollKey
                        );

                    },
                    50
                );

            }
        );

    </script>

}
