@using System.Globalization
@using System.Linq
@model HeThongDatTiecCuoi_WEB.Models.AdminThucDon.QuanLyThucDonViewModel

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Quản lý Thực đơn & Món ăn";
    ViewData["ActiveMenu"] = "ThucDon";

    var tongThucDon = Model.DanhSachThucDon.Count;
    var thucDonApDung = Model.DanhSachThucDon.Count(
        x => x.TrangThai == MenuStatusCodes.Active
    );

    var tongMonAn = Model.DanhSachMonAn.Count;
    var monDangPhucVu = Model.DanhSachMonAn.Count(
        x => x.TrangThai == DishStatusCodes.Active
    );

    var giaBinhQuan = tongThucDon > 0
        ? Model.DanhSachThucDon.Average(x => x.GiaMoiBan)
        : 0;

    var thucDonDangChon = Model.DanhSachThucDon
        .FirstOrDefault(
            x => x.ThucDonID == Model.ThucDonDangChonID
        );

    var soMonKhaiVi = Model.DanhSachMonAn.Count(
        x => x.NhomMon == "Món khai vị"
    );

    var soMonSup = Model.DanhSachMonAn.Count(
        x => x.NhomMon == "Món súp"
    );

    var soMonChinh = Model.DanhSachMonAn.Count(
        x => x.NhomMon == "Món chính"
    );

    var soMonTrangMieng = Model.DanhSachMonAn.Count(
        x => x.NhomMon == "Món tráng miệng"
    );
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-thuc-don.css"
          asp-append-version="true" />
}


<!-- =====================================================
     HEADER
     ===================================================== -->
<header class="top-header food-header">

    <div>

        <div class="breadcrumb">
            Quản trị Master Data
            <span>›</span>
            <strong>Quản lý Thực đơn & Món ăn</strong>
        </div>

        <div class="food-title-row">

            <div>
                <h2>
                    Quản Trị Danh Mục Thực Đơn & Ẩm Thực Tiệc Cưới
                </h2>
            </div>

        </div>

    </div>


    <div class="food-header-actions">

        <button type="button"
                class="food-button food-button-gold"
                data-open-modal="createMenuModal">

            <i class="fa-solid fa-circle-plus"></i>

            Thêm thực đơn mới

        </button>

    </div>

</header>


<!-- =====================================================
     PAGE CONTENT
     ===================================================== -->
<section class="content food-page">


    <!-- =========================
         THÔNG BÁO
         ========================= -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="food-alert success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @successMessage
            </span>

        </div>
    }


    @if (TempData["Error"] is string errorMessage)
    {
        <div class="food-alert error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @errorMessage
            </span>

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="food-alert error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- =====================================================
         4 THẺ THỐNG KÊ
         ===================================================== -->

    <div class="food-stat-grid">


        <!-- TỔNG THỰC ĐƠN -->
        <div class="food-stat-card">

            <div>

                <span class="food-stat-label">
                    Tổng số thực đơn
                </span>

                <div class="food-stat-value">

                    <strong>
                        @tongThucDon
                    </strong>

                    <span>
                        Bộ thực đơn
                    </span>

                </div>

                <div class="food-stat-note">
                    <i class="fa-regular fa-circle-check"></i>
                    @thucDonApDung thực đơn đang áp dụng
                </div>

            </div>

            <div class="food-stat-icon gold">
                <i class="fa-solid fa-book-open"></i>
            </div>

        </div>


        <!-- TỔNG MÓN -->
        <div class="food-stat-card">

            <div>

                <span class="food-stat-label">
                    Món trong kho Master
                </span>

                <div class="food-stat-value">

                    <strong>
                        @tongMonAn
                    </strong>

                    <span>
                        Món ăn
                    </span>

                </div>

                <div class="food-stat-note">
                    <i class="fa-solid fa-utensils"></i>
                    @monDangPhucVu món đang phục vụ
                </div>

            </div>

            <div class="food-stat-icon blue">
                <i class="fa-solid fa-utensils"></i>
            </div>

        </div>


        <!-- GIÁ BÌNH QUÂN -->
        <div class="food-stat-card">

            <div>

                <span class="food-stat-label">
                    Giá thực đơn bình quân
                </span>

                <div class="food-stat-value price">

                    <strong>
                        @giaBinhQuan.ToString("N0")
                    </strong>

                    <span>
                        VNĐ / bàn
                    </span>

                </div>

                <div class="food-stat-note">
                    Theo danh sách đang hiển thị
                </div>

            </div>

            <div class="food-stat-icon blue">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>

        </div>


        <!-- NHÓM MÓN -->
        <div class="food-stat-card">

            <div>

                <span class="food-stat-label">
                    Nhóm món chuẩn hóa
                </span>

                <div class="food-stat-value">

                    <strong>
                        4
                    </strong>

                    <span>
                        Nhóm món
                    </span>

                </div>

                <div class="food-stat-note">
                    Khai vị • Súp • Chính • Tráng miệng
                </div>

            </div>

            <div class="food-stat-icon gold">
                <i class="fa-solid fa-layer-group"></i>
            </div>

        </div>

    </div>



    <!-- =====================================================
         MASTER DETAIL
         ===================================================== -->

    <div class="food-master-detail">


        <!-- =================================================
             LEFT: THỰC ĐƠN
             ================================================= -->
        <div class="food-menu-column">


            <!-- HEADER -->
            <div class="food-panel">

                <div class="food-panel-title">

                    <div>

                        <div class="food-heading-row">

                            <h3>
                                Danh Sách Set Menu
                            </h3>

                            <span class="food-count">
                                @tongThucDon bộ
                            </span>

                        </div>

                        <p>
                            Quản lý giá mỗi bàn, trạng thái và thành phần món.
                        </p>

                    </div>

                </div>


                <!-- STATUS FILTER -->
                <div class="food-pills">

                    <a class="food-pill
                        @(string.IsNullOrWhiteSpace(Model.TrangThaiThucDon)
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = "",
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = Model.NhomMon,
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Tất cả

                    </a>


                    <a class="food-pill
                        @(Model.TrangThaiThucDon == MenuStatusCodes.Active
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = MenuStatusCodes.Active,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = Model.NhomMon,
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Đang áp dụng

                    </a>


                    <a class="food-pill
                        @(Model.TrangThaiThucDon == MenuStatusCodes.Inactive
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = MenuStatusCodes.Inactive,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = Model.NhomMon,
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Ngừng áp dụng

                    </a>

                </div>


                <!-- SEARCH MENU -->
                <form method="get"
                      asp-controller="AdminThucDon"
                      asp-action="Index"
                      class="food-search-box">

                    <input type="hidden"
                           name="thucDonId"
                           value="@Model.ThucDonDangChonID" />

                    <input type="hidden"
                           name="trangThaiThucDon"
                           value="@Model.TrangThaiThucDon" />

                    <input type="hidden"
                           name="tuKhoaMonAn"
                           value="@Model.TuKhoaMonAn" />

                    <input type="hidden"
                           name="nhomMon"
                           value="@Model.NhomMon" />

                    <input type="hidden"
                           name="trangThaiMonAn"
                           value="@Model.TrangThaiMonAn" />


                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           name="tuKhoaThucDon"
                           value="@Model.TuKhoaThucDon"
                           placeholder="Tìm tên hoặc mã thực đơn..." />

                </form>

            </div>


            <!-- =============================================
                 MENU CARDS
                 ============================================= -->

            <div class="food-menu-list">

                @if (Model.DanhSachThucDon.Count == 0)
                {
                    <div class="food-empty">
                        Không tìm thấy thực đơn phù hợp.
                    </div>
                }
                else
                {
                    @foreach (var thucDon in Model.DanhSachThucDon)
                    {
                        var selected =
                            thucDon.ThucDonID ==
                            Model.ThucDonDangChonID;

                        <div class="food-menu-card @(selected ? "selected" : "")">


                            <!-- TOP -->
                            <div class="food-menu-card-top">

                                <div class="food-menu-main">

                                    <div class="food-menu-meta">

                                        <span class="food-status
                                            @(thucDon.TrangThai == MenuStatusCodes.Active
                                                ? "active"
                                                : "inactive")">

                                            @StatusDisplayNames.GetMenuStatusName(thucDon.TrangThai)

                                        </span>

                                        <span class="food-code">
                                            MÃ: @thucDon.MaThucDon
                                        </span>

                                    </div>


                                    <h4>
                                        @thucDon.TenThucDon
                                    </h4>


                                    @if (!string.IsNullOrWhiteSpace(thucDon.MoTa))
                                    {
                                        <p>
                                            @thucDon.MoTa
                                        </p>
                                    }

                                </div>


                                <div class="food-menu-price">

                                    <strong>
                                        @thucDon.GiaMoiBan.ToString("N0")
                                    </strong>

                                    <span>
                                        VNĐ / bàn
                                    </span>

                                </div>

                            </div>


                            <!-- =================================
                                 THỰC ĐƠN ĐƯỢC CHỌN
                                 ================================= -->
                            @if (selected)
                            {
                                <div class="food-composition">


                                    <div class="food-composition-header">

                                        <strong>
                                            Danh mục
                                            @Model.DanhSachMonTrongThucDon.Count
                                            món:
                                        </strong>

                                        <span>
                                            Thành phần thực đơn
                                        </span>

                                    </div>


                                    <!-- ADD DISH -->
                                    <form method="post"
                                          asp-controller="AdminThucDon"
                                          asp-action="ThemMonVaoThucDon"
                                          class="food-add-dish-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="thucDonId"
                                               value="@thucDon.ThucDonID" />


                                        <select name="monAnId"
                                                required>

                                            <option value="">
                                                Chọn món đang phục vụ...
                                            </option>


                                            @foreach (
                                                var mon
                                                in Model.DanhSachMonDangPhucVu
                                                    .Where(
                                                        x =>
                                                            !Model
                                                                .DanhSachMonTrongThucDon
                                                                .Any(
                                                                    ct =>
                                                                        ct.MonAnID ==
                                                                        x.MonAnID
                                                                )
                                                    )
                                            )
                                            {
                                                <option value="@mon.MonAnID">
                                                    @mon.MaMon - @mon.TenMon
                                                </option>
                                            }

                                        </select>


                                        <button type="submit">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>

                                    </form>


                                    <!-- COMPOSITION LIST -->
                                    @if (Model.DanhSachMonTrongThucDon.Count == 0)
                                    {
                                        <div class="food-composition-empty">
                                            Thực đơn chưa có món ăn.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="food-composition-grid"
                                             id="compositionList">


                                            @for (
                                                var i = 0;
                                                i < Model.DanhSachMonTrongThucDon.Count;
                                                i++
                                            )
                                            {
                                                var mon =
                                                    Model.DanhSachMonTrongThucDon[i];


                                                <div class="food-composition-item"
                                                     data-mon-id="@mon.MonAnID"
                                                     data-index="@i">


                                                    <div class="food-composition-text">

                                                        <span class="food-order">
                                                            @(i + 1).
                                                        </span>

                                                        <span>
                                                            @mon.TenMon
                                                        </span>

                                                    </div>


                                                    <div class="food-composition-actions">

                                                        <button type="button"
                                                                class="food-small-btn move-dish"
                                                                data-index="@i"
                                                                data-direction="up"
                                                                title="Đưa lên">

                                                            <i class="fa-solid fa-chevron-up"></i>

                                                        </button>


                                                        <button type="button"
                                                                class="food-small-btn move-dish"
                                                                data-index="@i"
                                                                data-direction="down"
                                                                title="Đưa xuống">

                                                            <i class="fa-solid fa-chevron-down"></i>

                                                        </button>


                                                        <form method="post"
                                                              asp-controller="AdminThucDon"
                                                              asp-action="XoaMonKhoiThucDon"
                                                              onsubmit="return confirm('Bỏ món này khỏi thực đơn?');">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="thucDonId"
                                                                   value="@thucDon.ThucDonID" />

                                                            <input type="hidden"
                                                                   name="monAnId"
                                                                   value="@mon.MonAnID" />

                                                            <button type="submit"
                                                                    class="food-small-btn danger">

                                                                <i class="fa-solid fa-xmark"></i>

                                                            </button>

                                                        </form>

                                                    </div>

                                                </div>
                                            }

                                        </div>


                                        <form method="post"
                                              asp-controller="AdminThucDon"
                                              asp-action="SapXepMonAn"
                                              id="reorderForm">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="thucDonId"
                                                   value="@thucDon.ThucDonID" />

                                            <input type="hidden"
                                                   name="danhSachMonAnID"
                                                   id="reorderIds" />

                                        </form>
                                    }

                                </div>
                            }


                            <!-- ACTIONS -->
                            <div class="food-menu-actions">


                                <button type="button"
                                        class="food-action gold edit-menu-button"
                                        data-id="@thucDon.ThucDonID"
                                        data-ten="@thucDon.TenThucDon"
                                        data-mota="@thucDon.MoTa"
                                        data-gia="@thucDon.GiaMoiBan.ToString(
                                                                                CultureInfo.InvariantCulture
                                                                            )">

                                    <i class="fa-solid fa-pen"></i>

                                    Chỉnh sửa

                                </button>


                                @if (!selected)
                                {
                                    <a class="food-action secondary"
                                       href="@Url.Action(
                                                                                  "Index",
                                                                                  "AdminThucDon",
                                                                                  new
                                                                                  {
                                                                                      thucDonId = thucDon.ThucDonID,
                                                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                                                      nhomMon = Model.NhomMon,
                                                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                                                  })">

                                        Xem chi tiết

                                        <i class="fa-solid fa-arrow-right"></i>

                                    </a>
                                }


                                <form method="post"
                                      asp-controller="AdminThucDon"
                                      asp-action="CapNhatTrangThaiThucDon">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="thucDonId"
                                           value="@thucDon.ThucDonID" />

                                    <input type="hidden"
                                           name="trangThai"
                                           value="@(thucDon.TrangThai == MenuStatusCodes.Active
                                                                                   ? MenuStatusCodes.Inactive
                                                                                   : MenuStatusCodes.Active)" />


                                    <button type="submit"
                                            class="food-status-toggle
                                        @(thucDon.TrangThai == MenuStatusCodes.Active
                                            ? "on"
                                            : "")"
                                            title="Đổi trạng thái"
                                            onclick="return confirm('Xác nhận đổi trạng thái thực đơn?');">

                                        <span></span>

                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                }

            </div>

        </div>


        <!-- =================================================
             RIGHT: MÓN ĂN
             ================================================= -->
        <div class="food-dish-column">


            <div class="food-panel food-dish-panel">


                <!-- HEADER -->
                <div class="food-dish-header">

                    <div>

                        <div class="food-heading-row">

                            <h3>
                                Kho Món Ăn & Cấu Phần Chi Tiết
                            </h3>

                            <span class="food-count">
                                @tongMonAn món
                            </span>

                        </div>

                        <p>
                            Quản lý món ăn chuẩn hóa,
                            nhóm món và trạng thái phục vụ.
                        </p>

                    </div>


                    <button type="button"
                            class="food-button food-button-dark"
                            data-open-modal="createDishModal">

                        <i class="fa-solid fa-plus"></i>

                        Thêm món mới

                    </button>

                </div>


                <!-- CATEGORY FILTER -->
                <div class="food-pills food-category-pills">


                    <a class="food-pill
                        @(string.IsNullOrWhiteSpace(Model.NhomMon)
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = "",
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Tất cả (@tongMonAn)

                    </a>


                    <a class="food-pill
                        @(Model.NhomMon == "Món khai vị"
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = "Món khai vị",
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Khai vị (@soMonKhaiVi)

                    </a>


                    <a class="food-pill
                        @(Model.NhomMon == "Món súp"
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = "Món súp",
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Món súp (@soMonSup)

                    </a>


                    <a class="food-pill
                        @(Model.NhomMon == "Món chính"
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = "Món chính",
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Món chính (@soMonChinh)

                    </a>


                    <a class="food-pill
                        @(Model.NhomMon == "Món tráng miệng"
                           ? "active"
                           : "")"
                       href="@Url.Action(
                                                  "Index",
                                                  "AdminThucDon",
                                                  new
                                                  {
                                                      thucDonId = Model.ThucDonDangChonID,
                                                      tuKhoaThucDon = Model.TuKhoaThucDon,
                                                      trangThaiThucDon = Model.TrangThaiThucDon,
                                                      tuKhoaMonAn = Model.TuKhoaMonAn,
                                                      nhomMon = "Món tráng miệng",
                                                      trangThaiMonAn = Model.TrangThaiMonAn
                                                  })">

                        Tráng miệng (@soMonTrangMieng)

                    </a>

                </div>


                <!-- SEARCH -->
                <form method="get"
                      asp-controller="AdminThucDon"
                      asp-action="Index"
                      class="food-search-box">

                    <input type="hidden"
                           name="thucDonId"
                           value="@Model.ThucDonDangChonID" />

                    <input type="hidden"
                           name="tuKhoaThucDon"
                           value="@Model.TuKhoaThucDon" />

                    <input type="hidden"
                           name="trangThaiThucDon"
                           value="@Model.TrangThaiThucDon" />

                    <input type="hidden"
                           name="nhomMon"
                           value="@Model.NhomMon" />

                    <input type="hidden"
                           name="trangThaiMonAn"
                           value="@Model.TrangThaiMonAn" />


                    <i class="fa-solid fa-magnifying-glass"></i>


                    <input type="text"
                           name="tuKhoaMonAn"
                           value="@Model.TuKhoaMonAn"
                           placeholder="Tìm kiếm theo tên hoặc mã món ăn..." />

                </form>


                <!-- TABLE -->
                <div class="food-table-wrapper">

                    <table class="food-table">

                        <thead>

                            <tr>

                                <th>
                                    Mã & Hình ảnh
                                </th>

                                <th>
                                    Tên món ăn
                                </th>

                                <th>
                                    Phân loại
                                </th>

                                <th>
                                    Trạng thái
                                </th>

                                <th class="center">
                                    Thao tác
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.DanhSachMonAn.Count == 0)
                            {
                                <tr>

                                    <td colspan="5">

                                        <div class="food-empty">
                                            Không tìm thấy món ăn phù hợp.
                                        </div>

                                    </td>

                                </tr>
                            }
                            else
                            {
                                @foreach (var monAn in Model.DanhSachMonAn)
                                {
                                    <tr>


                                        <!-- IMAGE + CODE -->
                                        <td>

                                            <div class="food-dish-id">

                                                @if (!string.IsNullOrWhiteSpace(monAn.HinhAnh))
                                                {
                                                    <img src="@($"https://localhost:7101{monAn.HinhAnh}")"
                                                         alt="@monAn.TenMon"
                                                         loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="food-no-image">
                                                        <i class="fa-regular fa-image"></i>
                                                    </div>
                                                }


                                                <span>
                                                    @monAn.MaMon
                                                </span>

                                            </div>

                                        </td>


                                        <!-- NAME -->
                                        <td>

                                            <strong class="food-dish-name">
                                                @monAn.TenMon
                                            </strong>

                                        </td>


                                        <!-- GROUP -->
                                        <td>

                                            <span class="food-group-badge">
                                                @(monAn.NhomMon ?? "Chưa phân nhóm")
                                            </span>

                                        </td>


                                        <!-- STATUS -->
                                        <td>

                                            <span class="food-dish-status
                                                @(monAn.TrangThai == DishStatusCodes.Active
                                                    ? "serving"
                                                    : "stopped")">

                                                @StatusDisplayNames.GetDishStatusName(monAn.TrangThai)

                                            </span>

                                        </td>


                                        <!-- ACTION -->
                                        <td class="center">

                                            <div class="food-row-actions">


                                                <button type="button"
                                                        class="food-icon-button edit-dish-button"
                                                        data-id="@monAn.MonAnID"
                                                        data-ten="@monAn.TenMon"
                                                        data-nhom="@monAn.NhomMon"
                                                        data-hinhanh="@monAn.HinhAnh"
                                                        title="Chỉnh sửa">

                                                    <i class="fa-solid fa-pen"></i>

                                                </button>


                                                <form method="post"
                                                      asp-controller="AdminThucDon"
                                                      asp-action="CapNhatTrangThaiMonAn">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="monAnId"
                                                           value="@monAn.MonAnID" />

                                                    <input type="hidden"
                                                           name="trangThai"
                                                           value="@(monAn.TrangThai == DishStatusCodes.Active
                                                                                                                   ? DishStatusCodes.Inactive
                                                                                                                   : DishStatusCodes.Active)" />


                                                    <button type="submit"
                                                            class="food-icon-button danger"
                                                            title="Đổi trạng thái"
                                                            onclick="return confirm('Xác nhận đổi trạng thái món ăn?');">

                                                        <i class="fa-solid
                                                            @(monAn.TrangThai == DishStatusCodes.Active
                                                               ? "fa-eye-slash"
                                                               : "fa-eye")">
                                                        </i>

                                                    </button>

                                                </form>

                                            </div>

                                        </td>


                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>


                <!-- FOOT NOTE -->
                <div class="food-soft-delete-note">

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        Món ăn không bị xóa cứng.
                        Hãy sử dụng trạng thái
                        <strong>Ngừng phục vụ</strong>
                        khi món không còn được sử dụng.
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>



