@model List<HeThongDatTiecCuoi_WEB.Models.MyBookings.MyBookingViewModel>
@{
    ViewData["Title"] = "Tiệc Của Tôi - Riverside Palace";
    ViewData["PublicActivePage"] = "my-bookings";
    var currentPhone = ViewBag.CurrentPhone as string ?? "";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

    <style>
        .myb-hero {
            position: relative;
            min-height: 420px;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 130px 20px 70px 20px;
            background: #0B1320;
        }
        .myb-hero-bg {
            position: absolute;
            inset: 0;
            background-image: url('/images/my-booking/my-booking-banner.jpg');
            background-size: cover;
            background-position: center 36%;
            filter: brightness(0.9) contrast(1.05);
            transform: scale(1.02);
            transition: transform 12s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .myb-hero:hover .myb-hero-bg {
            transform: scale(1.07);
        }
        .myb-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(11, 19, 32, 0.88) 0%, rgba(15, 23, 42, 0.72) 45%, rgba(22, 40, 57, 0.86) 100%);
            backdrop-filter: blur(1.5px);
        }
        .myb-hero-inner {
            position: relative;
            z-index: 2;
            max-width: 1140px;
            margin: 0 auto;
            width: 100%;
        }
        .myb-hero-copy {
            max-width: 720px;
            color: #FFFFFF;
        }
        .myb-hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 999px;
            background: rgba(212, 175, 55, 0.14);
            border: 1px solid rgba(212, 175, 55, 0.35);
            color: var(--rp-gold, #C5A880);
            font-family: var(--font-sans-ui, "Plus Jakarta Sans", sans-serif);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 16px;
            backdrop-filter: blur(8px);
        }
        .myb-hero-eyebrow .material-symbols-outlined {
            color: var(--rp-gold, #C5A880);
            font-size: 16px;
        }
        .myb-hero h1 {
            font-family: var(--font-serif-display, "Cormorant Garamond", serif);
            font-size: clamp(32px, 4.2vw, 54px);
            font-weight: 500;
            line-height: 1.18;
            letter-spacing: 0.01em;
            color: #FFFFFF;
            margin: 0 0 14px 0;
            text-shadow: none;
        }
        .myb-hero h1 em,
        .myb-hero h1 strong {
            font-style: italic;
            font-weight: 500;
            color: var(--rp-gold, #C5A880);
        }
        .myb-hero-desc {
            font-family: var(--font-sans-ui, "Plus Jakarta Sans", sans-serif);
            font-size: 15px;
            font-weight: 400;
            line-height: 1.65;
            color: rgba(255, 255, 255, 0.9);
            margin: 0 0 24px 0;
        }
        .myb-hero-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        .myb-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            color: #F8FAFC;
            backdrop-filter: blur(12px);
            transition: all 0.25s ease;
        }
        .myb-hero-badge:hover {
            background: rgba(212, 175, 55, 0.25);
            border-color: rgba(212, 175, 55, 0.6);
            transform: translateY(-2px);
            color: #F7EFCF;
        }
        .myb-hero-badge .material-symbols-outlined {
            font-size: 18px;
            color: #D4AF37;
        }
        .myb-page-wrap {
            background-color: #FAF8F5;
            padding: 0 20px 80px 20px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1E293B;
            min-height: 60vh;
        }

        .myb-container {
            max-width: 1140px;
            margin: -50px auto 0 auto;
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .myb-card {
            background: #FFFFFF;
            border-radius: 24px;
            border: 1px solid #E2E8F0;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
            padding: 28px;
            transition: all 0.2s;
        }

            .myb-card:hover {
                border-color: #B89758;
                box-shadow: 0 15px 30px -8px rgba(184, 151, 88, 0.15);
            }

        .myb-badge-pending {
            background: #FEF3C7;
            color: #92400E;
            border: 1px solid #FDE68A;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

        .myb-badge-success {
            background: #ECFDF5;
            color: #065F46;
            border: 1px solid #A7F3D0;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

        .myb-badge-cancelled {
            background: #F1F5F9;
            color: #64748B;
            border: 1px solid #E2E8F0;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
        }

        .myb-stepper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            margin: 24px 0 16px 0;
            padding: 0 10px;
        }

            .myb-stepper::before {
                content: '';
                position: absolute;
                top: 14px;
                left: 20px;
                right: 20px;
                height: 2px;
                background: #E2E8F0;
                z-index: 1;
            }

        .myb-step-item {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: #FFFFFF;
            padding: 0 8px;
        }

        .myb-step-dot {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            transition: all 0.2s;
        }

        .myb-step-active {
            background: #B89758;
            color: #FFFFFF;
            box-shadow: 0 0 0 4px rgba(184, 151, 88, 0.2);
        }

        .myb-step-done {
            background: #10B981;
            color: #FFFFFF;
        }

        .myb-step-wait {
            background: #F1F5F9;
            color: #94A3B8;
            border: 1.5px solid #CBD5E1;
        }
    </style>
}

<div class="home-page my-booking-page">
    <!-- Header kế thừa đồng bộ -->
    <partial name="_PublicHeader" />

    <!-- HERO BANNER CỰC ĐẸP CHO TIỆC CỦA TÔI -->
    <section class="myb-hero" aria-labelledby="myb-hero-title">
        <div class="myb-hero-bg" aria-hidden="true"></div>
        <div class="myb-hero-overlay" aria-hidden="true"></div>
        <div class="home-container myb-hero-inner">
            <div class="myb-hero-copy">
                <h1 id="myb-hero-title">Tiệc Cưới <em>Của Tôi</em></h1>
                <p class="myb-hero-desc">
                    Đồng hành cùng hai bạn trong từng khoảnh khắc trăm năm. Tra cứu chi tiết hồ sơ đặt tiệc, tiến độ chuẩn bị, thanh toán đặt cọc và gửi yêu cầu thay đổi lịch linh hoạt 24/7.
                </p>
                <div class="myb-hero-badges">
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span>Tra cứu minh bạch</span>
                    </div>
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">payments</span>
                        <span>Thanh toán tiện lợi</span>
                    </div>
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">edit_calendar</span>
                        <span>Hỗ trợ đổi lịch 24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="myb-page-wrap">
        <div class="myb-container">

            <!-- Tiêu đề danh sách -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid #E2E8F0; padding-bottom: 16px;">
                <div>
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #0F172A; margin: 0;">
                        Danh Sách Đơn Đặt Tiệc Của Bạn
                    </h2>
                    <span style="font-size: 13px; color: #64748B;">Tra cứu theo số điện thoại đã đăng ký đặt tiệc</span>
                </div>

                <!-- Ô tìm kiếm bằng số điện thoại nếu khách chưa đăng nhập -->
                <form method="get" asp-action="Index" style="display: flex; gap: 8px;">
                    <input type="tel" name="phone" value="@currentPhone" placeholder="Nhập SĐT để tra cứu..." style="padding: 10px 14px; border-radius: 12px; border: 1px solid #CBD5E1; font-size: 13px; outline: none; width: 200px;">
                    <button type="submit" style="padding: 10px 18px; border-radius: 12px; background: #B89758; color: #FFF; font-weight: 700; border: none; font-size: 13px; cursor: pointer;">
                        <i class="fa-solid fa-magnifying-glass"></i> Tra cứu
                    </button>
                </form>
            </div>

            <!-- Danh sách đơn tiệc -->
            @if (Model == null || Model.Count == 0)
            {
                <div class="myb-card" style="text-align: center; padding: 60px 20px;">
                    <div style="width: 64px; height: 64px; border-radius: 50%; background: #FAF8F5; border: 1px solid #E2E8F0; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; font-size: 26px; color: #94A3B8;">
                        <i class="fa-regular fa-calendar-xmark"></i>
                    </div>
                    <h3 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #0F172A; margin: 0 0 8px 0;">
                        Hai bạn chưa có đơn tiệc cưới nào
                    </h3>
                    <p style="font-size: 13px; color: #64748B; margin: 0 0 20px 0; max-width: 480px; margin-left: auto; margin-right: auto;">
                        Hãy trải nghiệm công nghệ AI Recommendation để nhận ngay Top 3 gói tiệc cưới tối ưu theo ngân sách và sở thích.
                    </p>
                    <a asp-controller="Recommendation" asp-action="Index" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 12px; background: #B89758; color: #FFFFFF; font-weight: 700; font-size: 13px; text-decoration: none;">
                        <i class="fa-solid fa-sparkles"></i> Nhận Gợi Ý Gói Tiệc Ngay
                    </a>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    @foreach (var item in Model)
                    {
                        var isCancelled = item.Status == "Đã hủy";
                        var isPending = item.Status == "Chờ xác nhận";
                        var isConfirmed = item.Status == "Đã cọc" || item.Status == "Đã ký hợp đồng" || item.Status == "Đã xác nhận" || item.HasContract;

                        <div class="myb-card">
                            <!-- Tiêu đề thẻ -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid #F1F5F9;">
                                <div>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <span style="font-family: monospace; font-size: 15px; font-weight: 800; color: #B89758; background: #FFF9EE; border: 1px solid #EEDBB2; padding: 2px 8px; border-radius: 6px;">
                                            @item.BookingCode
                                        </span>
                                        @if (isPending)
                                        {
                                            <span class="myb-badge-pending"><i class="fa-regular fa-clock"></i> Chờ xác nhận</span>
                                        }
                                        else if (isCancelled)
                                        {
                                            <span class="myb-badge-cancelled"><i class="fa-solid fa-ban"></i> Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="myb-badge-success"><i class="fa-solid fa-circle-check"></i> @item.Status</span>
                                        }
                                    </div>
                                    <span style="font-size: 11px; color: #94A3B8; display: block; margin-top: 4px;">
                                        Thời gian đăng ký: @item.BookedAt.ToString("HH:mm - dd/MM/yyyy")
                                    </span>
                                </div>

                                <div style="text-align: right;">
                                    <span style="font-size: 11px; color: #64748B;">Dự toán trọn gói:</span>
                                    <span style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #0F172A; display: block;">
                                        @item.EstimatedTotal.ToString("N0") đ
                                    </span>
                                </div>
                            </div>

                            <!-- Stepper Tiến trình tiệc cưới (Không hiển thị khi đã hủy) -->
                            @if (!isCancelled)
                            {
                                <div class="myb-stepper">
                                    <div class="myb-step-item">
                                        <div class="myb-step-dot @(isPending ? "myb-step-active" : "myb-step-done")">1</div>
                                        <span style="font-size: 11px; font-weight: 700; color: #0F172A;">Giữ chỗ</span>
                                    </div>
                                    <div class="myb-step-item">
                                        <div class="myb-step-dot @(isPending ? "myb-step-wait" : "myb-step-active")">2</div>
                                        <span style="font-size: 11px; font-weight: 600; color: #64748B;">Tư vấn sảnh</span>
                                    </div>
                                    <div class="myb-step-item">
                                        <div class="myb-step-dot @(isConfirmed || item.HasContract ? "myb-step-done" : "myb-step-wait")">3</div>
                                        <span style="font-size: 11px; font-weight: 600; color: #64748B;">Ký hợp đồng</span>
                                    </div>
                                    <div class="myb-step-item">
                                        <div class="myb-step-dot myb-step-wait">4</div>
                                        <span style="font-size: 11px; font-weight: 600; color: #64748B;">Chuẩn bị</span>
                                    </div>
                                    <div class="myb-step-item">
                                        <div class="myb-step-dot myb-step-wait">5</div>
                                        <span style="font-size: 11px; font-weight: 600; color: #64748B;">Hoàn tất</span>
                                    </div>
                                </div>
                            }

                            <!-- Nội dung 4 cột thông tin -->
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; background: #FAF8F5; padding: 18px; border-radius: 16px; border: 1px solid #E2E8F0; margin-top: 14px; font-size: 12.5px;">
                                <div>
                                    <span style="color: #64748B; display: block; margin-bottom: 2px;">Không gian &amp; Thời gian:</span>
                                    <strong style="color: #0F172A; display: flex; align-items: center; gap: 6px;">
                                        <i class="fa-solid fa-archway" style="color: #B89758;"></i> Sảnh @item.HallName
                                    </strong>
                                    <span style="color: #334155; font-size: 12px; display: block; margin-top: 2px;">
                                        @item.Shift, @item.EventDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <div>
                                    <span style="color: #64748B; display: block; margin-bottom: 2px;">Quy mô tiệc cưới:</span>
                                    <strong style="color: #0F172A; display: flex; align-items: center; gap: 6px;">
                                        <i class="fa-solid fa-users" style="color: #B89758;"></i> @item.TableCount bàn tiệc
                                    </strong>
                                    <span style="color: #64748B; font-size: 12px; display: block; margin-top: 2px;">
                                        Dự kiến khoảng @item.GuestCount khách
                                    </span>
                                </div>

                                <div>
                                    <span style="color: #64748B; display: block; margin-bottom: 2px;">Ẩm thực &amp; Trang trí:</span>
                                    <span style="color: #0F172A; font-weight: 600; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        🍲 @item.MenuName
                                    </span>
                                    <span style="color: #64748B; font-size: 12px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px;">
                                        ✨ @item.DecorName
                                    </span>
                                </div>

                            </div>

                            <!-- Nút thao tác -->
                            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 16px;">
                                @if (item.HasContract)
                                {
                                    <a href="/MyBooking?bookingCode=@item.BookingCode&phone=@currentPhone" class="myb-btn-primary" style="padding: 9px 16px; border-radius: 10px; background: #B89758; color: #FFFFFF; font-weight: 700; font-size: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                        <i class="fa-regular fa-file-lines"></i> Xem Hợp Đồng
                                    </a>
                                    <a href="/MyBookings/DownloadContractPdf?bookingCode=@item.BookingCode&phone=@currentPhone" target="_blank" style="padding: 9px 16px; border-radius: 10px; background: #FFFFFF; border: 1px solid #B89758; color: #B89758; font-weight: 700; font-size: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                        <i class="fa-solid fa-file-arrow-down"></i> Tải PDF Hợp Đồng
                                    </a>
                                }
                                @if (isPending)
                                {
                                    <button type="button" onclick="cancelMyBooking(@item.BookingId, '@item.BookingCode')" style="padding: 9px 16px; border-radius: 10px; background: #FFFFFF; border: 1px solid #EF4444; color: #EF4444; font-weight: 700; font-size: 12px; cursor: pointer;">
                                        <i class="fa-regular fa-trash-can"></i> Hủy Giữ Chỗ
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </main>

    <!-- Footer kế thừa đồng bộ -->
    <partial name="_PublicFooter" />
</div>

@section Scripts {
    <script>
        async function cancelMyBooking(bookingId, bookingCode) {
            if (!confirm(`Bạn có chắc chắn muốn hủy yêu cầu giữ chỗ cho đơn tiệc [${bookingCode}]?`)) {
                return;
            }

            try {
                const res = await fetch(`/MyBookings/CancelBooking?bookingId=${bookingId}`, {
                    method: 'POST'
                });
                const result = await res.json();
                if (result.success) {
                    alert("Đã hủy đơn giữ chỗ tiệc cưới thành công!");
                    window.location.reload();
                } else {
                    alert(result.message || "Không thể hủy đơn lúc này.");
                }
            } catch (e) {
                alert("Lỗi kết nối khi gửi yêu cầu hủy đơn.");
            }
        }
    </script>
}
