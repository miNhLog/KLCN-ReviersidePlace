                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-emerald-50 border border-emerald-300 shadow-2xs text-emerald-800 font-semibold text-[11px]">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-[10px]"></i>
                        <span>Hoàn tất</span>
                    </div>
                </div>

                <!-- Nút đóng -->
                <div class="flex items-center justify-end">
                    <button type="button"
                            onclick="closeHallMatrixModal()"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-gradient-to-r from-[#1E293B] to-[#0F172A] hover:from-[#0F172A] hover:to-black active:scale-95 text-white rounded-lg text-xs font-semibold shadow-md transition-all cursor-pointer">
                        <i class="fa-solid fa-xmark text-slate-400 text-xs"></i>
                        <span>Đóng cửa sổ</span>
