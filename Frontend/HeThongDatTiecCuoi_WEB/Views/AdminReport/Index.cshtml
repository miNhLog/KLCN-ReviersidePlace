                              class="px-4 text-xs font-bold text-slate-800 font-mono tracking-wide text-center min-w-[180px]">
                            Đang đồng bộ...
                        </span>
                        <button type="button" onclick="changeMatrixWeek(7)"
                                class="w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-l border-slate-200"
                                title="Tuần sau">
