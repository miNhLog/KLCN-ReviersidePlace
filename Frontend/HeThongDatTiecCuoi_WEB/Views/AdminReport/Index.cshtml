                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Tuần làm việc:</span>
                    <div class="flex items-center bg-white border border-[#E5D5B8] rounded-lg shadow-2xs overflow-hidden">
                        <button type="button" onclick="changeMatrixWeek(-7)"
                                class="w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-r border-slate-200"
                                title="Tuần trước">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
