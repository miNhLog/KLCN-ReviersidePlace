@model HeThongDatTiecCuoi_WEB.Models.Notification.NotificationPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thông báo";
}

<main class="notifications-page">
    <header class="notification-page-header">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="fa-regular fa-bell" aria-hidden="true"></i> TRUNG TÂM THÔNG BÁO</span>
            <h1>Thông báo</h1>
            <p>Theo dõi thông báo và cập nhật quan trọng liên quan đến công việc.</p>
        </div>
    </header>

    <div class="notification-toolbar">
        <nav class="notification-filters" aria-label="Lọc thông báo theo trạng thái">
            <a asp-action="Index" class="@(string.IsNullOrWhiteSpace(Model.ReadStatus) ? "active" : "")">Tất cả</a>
            <a asp-action="Index" asp-route-readStatus="UNREAD" class="@(Model.ReadStatus == "UNREAD" ? "active" : "")">Chưa đọc</a>
            <a asp-action="Index" asp-route-readStatus="READ" class="@(Model.ReadStatus == "READ" ? "active" : "")">Đã đọc</a>
        </nav>
        @if (Model.UnreadCount > 0)
        {
            <button type="button" class="notification-mark-all" id="pageMarkAllRead">Đánh dấu tất cả đã đọc</button>
        }
    </div>

    @if (Model.ErrorMessage is not null)
    {
        <div class="role-alert error">@Model.ErrorMessage</div>
    }

    <section class="notification-page-list" aria-label="Danh sách thông báo">
        @if (Model.Items.Count == 0)
        {
            <div class="notification-page-empty">
                <i class="fa-regular fa-bell-slash" aria-hidden="true"></i>
                <h2>Chưa có thông báo</h2>
                <p>Các cập nhật quan trọng sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <button type="button"
                        class="notification-page-item @(!item.IsRead ? "unread" : "")"
                        data-notification-id="@item.NotificationId"
                        data-navigation-url="@item.NavigationUrl">
                    <span class="notification-type-icon"><i class="fa-regular fa-bell" aria-hidden="true"></i></span>
                    <span>
                        <strong>@item.Title</strong>
                        <span>@item.Message</span>
                        <small data-created-at="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </span>
                    @if (!item.IsRead)
                    {
                        <i class="notification-unread-dot" aria-label="Chưa đọc"></i>
                    }
                </button>
            }
        }
    </section>

    @if (Model.TotalPages > 1)
    {
        <nav class="notification-pagination" aria-label="Phân trang thông báo">
            <a class="pagination-edge @(Model.CurrentPage <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-readStatus="@Model.ReadStatus">Trước</a>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index" asp-route-page="@pageNumber" asp-route-readStatus="@Model.ReadStatus" class="@(pageNumber == Model.CurrentPage ? "active" : "")">@pageNumber</a>
            }
            <a class="pagination-edge @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-readStatus="@Model.ReadStatus">Sau</a>
        </nav>
    }
</main>
