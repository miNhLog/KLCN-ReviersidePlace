@model HeThongDatTiecCuoi_WEB.Models.MyBookings.PublicBookingLookupInputViewModel
@using HeThongDatTiecCuoi_WEB.Models.MyBookings
@functions {
    public static string MaskPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "---";
        var clean = phone.Trim();
        if (clean.Contains('@'))
        {
            var atIndex = clean.IndexOf('@');
            var name = clean.Substring(0, atIndex);
            var domain = clean.Substring(atIndex);
            if (name.Length <= 2) return string.Concat(name[0], "***", domain);
            return string.Concat(name.Substring(0, 2), "***", domain);
        }
        if (clean.Length <= 4) return "****";
        if (clean.Length <= 7) return string.Concat(clean.Substring(0, 2), "***", clean.Substring(clean.Length - 2));
        return string.Concat(clean.Substring(0, 3), "***", clean.Substring(clean.Length - 4));
    }
}
@{
    ViewData["Title"] = "Tra cứu tiệc cưới trực tuyến - Riverside Palace";
    ViewData["PublicActivePage"] = "my-bookings";
    var detail = ViewBag.LookupDetail as PublicBookingDetailViewModel;
    var lookupError = ViewBag.LookupError as string;
    var myBookings = ViewBag.MyBookings as List<MyBookingViewModel> ?? new List<MyBookingViewModel>();
    string[] steps = new[] { "Chờ xác nhận", "Đã xác nhận", "Đã cọc", "Đang chuẩn bị", "Hoàn tất" };
    int currentStep = 0;
    if (detail != null)
    {
        currentStep = detail.StatusCode switch
        {
            "PENDING" => 0,
            "CONFIRMED" => 1,
            "PREPARING" => 3,
            "COMPLETED" => 4,
            "CANCELLED" => -1,
            _ => detail.StatusName switch
            {
                "Chờ xác nhận" => 0,
                "Đã xác nhận" => 1,
                "Đang chuẩn bị" => 3,
                "Hoàn tất" => 4,
                _ => detail.DepositPaid > 0 ? 2 : 1
            }
        };
        if (detail.DepositPaid > 0 && currentStep == 1) { currentStep = 2; }
    }
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-deposit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule-change.css" asp-append-version="true" />
    <style>
        :root { --rp-gold: #B89758; --rp-ink: #111822; --rp-cream: #FDFBF7; }
        .myb-hero {
            position: relative;
            min-height: 420px;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 130px 20px 70px 20px;
            background: #0B1320;
        }
        .myb-hero-bg {
            position: absolute;
            inset: 0;
            background-image: url('/images/my-booking/my-booking-banner.jpg');
            background-size: cover;
            background-position: center 36%;
            filter: brightness(0.9) contrast(1.05);
            transform: scale(1.02);
            transition: transform 12s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .myb-hero:hover .myb-hero-bg {
            transform: scale(1.07);
        }
        .myb-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(11, 19, 32, 0.88) 0%, rgba(15, 23, 42, 0.72) 45%, rgba(22, 40, 57, 0.86) 100%);
            backdrop-filter: blur(1.5px);
        }
        .myb-hero-inner {
            position: relative;
            z-index: 2;
            max-width: 1140px;
            margin: 0 auto;
            width: 100%;
        }
        .myb-hero-copy {
            max-width: 720px;
            color: #FFFFFF;
        }
        .myb-hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 999px;
            background: rgba(212, 175, 55, 0.14);
            border: 1px solid rgba(212, 175, 55, 0.35);
            color: var(--rp-gold, #C5A880);
            font-family: var(--font-sans-ui, "Plus Jakarta Sans", sans-serif);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 16px;
            backdrop-filter: blur(8px);
        }
        .myb-hero-eyebrow .material-symbols-outlined {
            color: var(--rp-gold, #C5A880);
            font-size: 16px;
        }
        .myb-hero h1 {
            font-family: var(--font-serif-display, "Cormorant Garamond", serif);
            font-size: clamp(32px, 4.2vw, 54px);
            font-weight: 500;
            line-height: 1.18;
            letter-spacing: 0.01em;
            color: #FFFFFF;
            margin: 0 0 14px 0;
            text-shadow: none;
        }
        .myb-hero h1 em,
        .myb-hero h1 strong {
            font-style: italic;
            font-weight: 500;
            color: var(--rp-gold, #C5A880);
        }
        .myb-hero-desc {
            font-family: var(--font-sans-ui, "Plus Jakarta Sans", sans-serif);
            font-size: 15px;
            font-weight: 400;
            line-height: 1.65;
            color: rgba(255, 255, 255, 0.9);
            margin: 0 0 24px 0;
        }
        .myb-hero-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        .myb-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            color: #F8FAFC;
            backdrop-filter: blur(12px);
            transition: all 0.25s ease;
        }
        .myb-hero-badge:hover {
            background: rgba(212, 175, 55, 0.25);
            border-color: rgba(212, 175, 55, 0.6);
            transform: translateY(-2px);
            color: #F7EFCF;
        }
        .myb-hero-badge .material-symbols-outlined {
            font-size: 18px;
            color: #D4AF37;
        }
        .rp-wrap { background: var(--rp-cream); padding: 0 20px 80px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--rp-ink); min-height: 60vh; flex: 1; }
        .rp-container { max-width: 1140px; margin: -50px auto 0 auto; position: relative; z-index: 10; display: flex; flex-direction: column; gap: 24px; }
        .rp-card { background: #fff; border-radius: 20px; border: 1px solid #E9E2D3; box-shadow: 0 10px 25px -5px rgba(17,24,34,.06); padding: 28px; }
        .rp-card:hover { border-color: var(--rp-gold); }
        .rp-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--rp-gold); }
        .rp-h1 { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: var(--rp-ink); margin: 4px 0 0; }
        .rp-sub { font-size: 13px; color: #64748B; margin-top: 6px; }
        .rp-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 18px; }
        @@media (max-width: 720px) { .rp-form-grid { grid-template-columns: 1fr; } }
        .rp-field label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 6px; }
        .rp-field label span.req { color: #DC2626; }
        .rp-field input { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid #CBD5E1; font-size: 14px; outline: none; font-family: monospace; }
        .rp-field input:focus { border-color: var(--rp-gold); box-shadow: 0 0 0 3px rgba(184,151,88,.18); }
        .rp-field .hint { font-size: 11.5px; color: #94A3B8; margin-top: 4px; font-family: 'Plus Jakarta Sans', sans-serif; }
        .rp-field .field-error { font-size: 12px; color: #DC2626; margin-top: 4px; display: none; }
        .rp-btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 13px 28px; border-radius: 12px; background: var(--rp-gold); color: #fff; font-weight: 800; font-size: 14px; border: none; cursor: pointer; text-decoration: none; }
        .rp-btn-gold:hover { filter: brightness(.95); }
        .rp-btn-danger { display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 12px; background: #fff; border: 1.5px solid var(--rp-gold); color: #DC2626; font-weight: 800; font-size: 13px; cursor: pointer; box-shadow: inset 0 0 0 1px rgba(220,38,38,.35); text-decoration: none; }
        .rp-btn-danger:hover { background: #FEF2F2; }
        .rp-alert-error { background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; border-radius: 12px; padding: 12px 16px; font-size: 13px; margin-top: 14px; }
        .rp-alert-empty { background: #FFFBEB; border: 1px dashed #E9D9AE; color: #78716C; border-radius: 12px; padding: 26px; text-align: center; font-size: 13px; }
        .rp-badge-cancelled { display: inline-flex; align-items: center; gap: 6px; background: #DC2626; color: #fff; font-weight: 800; font-size: 12px; padding: 5px 14px; border-radius: 999px; letter-spacing: .04em; }
        .rp-badge-pending { background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; }
        .rp-badge-success { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; }
        .rp-code { font-family: monospace; font-weight: 800; color: var(--rp-gold); background: #FFF9EE; border: 1px solid #EEDBB2; padding: 3px 10px; border-radius: 8px; font-size: 15px; }
        .rp-stepper { display: flex; align-items: flex-start; justify-content: space-between; position: relative; margin: 24px 0 8px; padding: 0 6px; }
        .rp-stepper::before { content: ''; position: absolute; top: 15px; left: 24px; right: 24px; height: 2px; background: #E2E8F0; z-index: 1; }
        .rp-step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 6px; background: #fff; padding: 0 6px; flex: 1; text-align: center; }
        .rp-dot { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; }
        .rp-dot.done { background: #10B981; color: #fff; }
        .rp-dot.active { background: var(--rp-gold); color: #fff; box-shadow: 0 0 0 4px rgba(184,151,88,.2); }
        .rp-dot.wait { background: #F1F5F9; color: #94A3B8; border: 1.5px solid #CBD5E1; }
        .rp-step span.lbl { font-size: 11px; font-weight: 700; color: var(--rp-ink); }
        .rp-grid-2 { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; margin-top: 16px; }
        @@media (max-width: 860px) { .rp-grid-2 { grid-template-columns: 1fr; } }
        .rp-info { background: #FAF8F5; border: 1px solid #E9E2D3; border-radius: 14px; padding: 16px 18px; font-size: 13px; }
        .rp-info h4 { margin: 0 0 10px; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--rp-gold); }
        .rp-kv { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px dashed #E9E2D3; }
        .rp-kv:last-child { border-bottom: none; }
        .rp-kv b { text-align: right; }
        .rp-dish { display: flex; gap: 8px; align-items: baseline; padding: 4px 0; font-size: 13px; }
        .rp-dish .n { color: var(--rp-gold); font-weight: 800; min-width: 22px; }
        .rp-countdown { background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px; padding: 12px 16px; font-size: 13px; color: #92400E; margin-top: 14px; }
        .rp-countdown b { font-variant-numeric: tabular-nums; }
        .rp-contact { background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 12px; padding: 14px 16px; font-size: 13px; color: #1E3A8A; margin-top: 14px; }
        .rp-modal-backdrop { position: fixed; inset: 0; background: rgba(17,24,34,.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 16px; }
        .rp-modal-backdrop.open { display: flex; }
        .rp-modal { background: #fff; border-radius: 18px; max-width: 520px; width: 100%; padding: 26px; border-top: 5px solid var(--rp-gold); }
        .rp-modal h3 { font-family: 'Playfair Display', serif; margin: 0 0 6px; font-size: 20px; }
        .rp-modal textarea { width: 100%; min-height: 96px; border-radius: 12px; border: 1px solid #CBD5E1; padding: 10px 12px; font-size: 13px; font-family: inherit; resize: vertical; }
        .rp-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
        .rp-btn-ghost { padding: 10px 18px; border-radius: 10px; border: 1px solid #CBD5E1; background: #fff; font-weight: 700; font-size: 13px; cursor: pointer; }
        .rp-btn-confirm-danger { padding: 10px 18px; border-radius: 10px; background: #DC2626; color: #fff; font-weight: 800; font-size: 13px; border: none; cursor: pointer; }

        @@media (max-width: 640px) {
            .rp-wrap { padding: 82px 14px 60px; }
            .rp-card { padding: 20px 16px; border-radius: 16px; }
            .rp-h1 { font-size: 26px; }
            .rp-stepper { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 8px; justify-content: flex-start; gap: 10px; -webkit-overflow-scrolling: touch; }
            .rp-stepper::before { display: none; }
            .rp-step { min-width: 78px; flex: none; }
            .rp-step span.lbl { font-size: 10px; white-space: nowrap; }
            .rp-dot { width: 26px; height: 26px; font-size: 11px; }
        }
    </style>
}

<div class="home-page my-booking-page">
    <partial name="_PublicHeader" />

    <nav class="public-breadcrumb" aria-label="Đường dẫn trang">
        <div class="home-container"><a asp-controller="Home" asp-action="Index" asp-route-publicSite="true">Trang chủ</a><span class="public-breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page">Tiệc của tôi</span></div>
    </nav>

    <!-- HERO BANNER CỰC ĐẸP CHO TIỆC CỦA TÔI -->
    <section class="myb-hero" aria-labelledby="myb-hero-title">
        <div class="myb-hero-bg" aria-hidden="true"></div>
        <div class="myb-hero-overlay" aria-hidden="true"></div>
        <div class="home-container myb-hero-inner">
            <div class="myb-hero-copy">
                <h1 id="myb-hero-title">Tiệc Cưới <em>Của Tôi</em></h1>
                <p class="myb-hero-desc">
                    Đồng hành cùng hai bạn trong từng khoảnh khắc trăm năm. Tra cứu chi tiết hồ sơ đặt tiệc, tiến độ chuẩn bị, thanh toán đặt cọc và gửi yêu cầu thay đổi lịch linh hoạt 24/7.
                </p>
                <div class="myb-hero-badges">
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span>Tra cứu minh bạch</span>
                    </div>
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">payments</span>
                        <span>Thanh toán tiện lợi</span>
                    </div>
                    <div class="myb-hero-badge">
                        <span class="material-symbols-outlined">edit_calendar</span>
                        <span>Hỗ trợ đổi lịch 24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="rp-wrap">
        <div class="rp-container">

            <!-- PHẦN 1: FORM TRA CỨU -->
            <section class="rp-card" aria-label="Form tra cứu hồ sơ tiệc cưới">
                <h2 style="font-family:'Playfair Display',serif;font-size:20px;margin:0;">Tra cứu hồ sơ tiệc cưới</h2>
                <p class="rp-sub">Hệ thống tự điền sẵn từ liên kết sau khi đặt giữ chỗ. Tra cứu sai quá 5 lần trong 15 phút sẽ bị khóa tạm thời.</p>
                <form asp-controller="MyBooking" asp-action="Lookup" method="post" id="lookupForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="rp-form-grid">
                        <div class="rp-field">
                            <label asp-for="BookingCode">Mã đặt tiệc <span class="req">*</span></label>
                            <input asp-for="BookingCode" id="bookingCodeInput" placeholder="DT-20261012-0001" maxlength="30" autocomplete="off" />
                            <div class="hint">Định dạng DT-yyyyMMdd-XXXX, ví dụ DT-20261012-0001.</div>
                            <div class="field-error" id="bookingCodeError">Mã đặt tiệc phải có dạng DT-yyyyMMdd-XXXX.</div>
                            <span asp-validation-for="BookingCode" style="font-size:12px;color:#DC2626;"></span>
                        </div>
                        <div class="rp-field">
                            <label asp-for="PhoneNumber">Email hoặc số điện thoại <span class="req">*</span></label>
                            <input asp-for="PhoneNumber" id="phoneInput" placeholder="email@gmail.com hoặc 0901234567" maxlength="320" inputmode="text" autocomplete="username" />
                            <div class="hint">Dùng đúng email hoặc số điện thoại đã đăng ký với tiệc.</div>
                            <div class="field-error" id="phoneError">Vui lòng nhập email hợp lệ hoặc số điện thoại 10 số bắt đầu bằng 0.</div>
                            <span asp-validation-for="PhoneNumber" style="font-size:12px;color:#DC2626;"></span>
                        </div>
                    </div>
                    <div style="margin-top:18px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
                        <button type="submit" class="rp-btn-gold"><i class="fa-solid fa-magnifying-glass"></i> Tra cứu hồ sơ tiệc cưới</button>
                        <a asp-controller="Recommendation" asp-action="Index" style="font-size:13px;color:#B89758;font-weight:700;">Chưa có mã? Đặt giữ chỗ ngay →</a>
                    </div>
                </form>
                @if (!string.IsNullOrWhiteSpace(lookupError))
                {
                    <div class="rp-alert-error" role="alert"><i class="fa-solid fa-circle-exclamation"></i> @lookupError</div>
                }
            </section>

            <!-- PHẦN 2: CHI TIẾT -->
            @if (detail != null)
            {
                <section class="rp-card" aria-label="Chi tiết hồ sơ tiệc cưới">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid #F1F5F9;">
                        <div>
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                <span class="rp-code">@detail.BookingCode</span>
                                @if (detail.IsCancelled)
                                {
                                    <span class="rp-badge-cancelled"><i class="fa-solid fa-ban"></i> ĐÃ HỦY</span>
                                }
                                else if (detail.IsPending)
                                {
                                    <span class="rp-badge-pending"><i class="fa-regular fa-clock"></i> Chờ xác nhận</span>
                                }
                                else
                                {
                                    <span class="rp-badge-success"><i class="fa-solid fa-circle-check"></i> @detail.StatusName</span>
                                }
                            </div>
                            <span style="font-size:11.5px;color:#94A3B8;display:block;margin-top:5px;">Ngày đặt: @detail.BookedAt.ToString("HH:mm - dd/MM/yyyy") · Khách: @detail.CustomerName (@MaskPhoneNumber(detail.PhoneNumber))</span>
                        </div>
                        <div style="text-align:right;">
                            <span style="font-size:11px;color:#64748B;">Tổng dự toán:</span>
                            <span style="font-family:'Playfair Display',serif;font-size:24px;font-weight:700;display:block;">@detail.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>

                    @if (!detail.IsCancelled)
                    {
                        <div class="rp-stepper" aria-label="Tiến trình hồ sơ">
                            @for (int i = 0; i < steps.Length; i++)
                            {
                                var cls = i < currentStep ? "done" : (i == currentStep ? "active" : "wait");
                                var num = i < currentStep ? "✓" : (i + 1).ToString();
                                <div class="rp-step"><div class="rp-dot @cls">@num</div><span class="lbl">@steps[i]</span></div>
                            }
                        </div>
                    }

                    <div class="rp-grid-2">
                        <div class="rp-info">
                            <h4>Tóm tắt tiệc cưới</h4>
                            <div class="rp-kv"><span>Ngày / Ca</span><b>@detail.EventDate.ToString("dd/MM/yyyy") · @detail.Shift</b></div>
                            <div class="rp-kv"><span>Sảnh</span><b>@detail.HallName (@detail.HallPrice.ToString("N0") đ)</b></div>
                            <div class="rp-kv"><span>Sức chứa sảnh</span><b>Tối đa @detail.HallCapacity khách</b></div>
                            <div class="rp-kv"><span>Quy mô</span><b>@detail.GuestCount khách = @detail.OfficialTables + @detail.SpareTables bàn (tổng @detail.TotalTables bàn)</b></div>
                            <div class="rp-kv"><span>Thực đơn (@(detail.Dishes.Count) món)</span><b>@(detail.MenuName ?? "—") @(detail.MenuPricePerTable.HasValue ? $"({detail.MenuPricePerTable.Value.ToString("N0")} đ/bàn)" : "")</b></div>
                            @if (detail.Dishes.Count > 0)
                            {
                                <div style="margin-top:8px;border-top:1px dashed #E9E2D3;padding-top:8px;">
                                    @foreach (var d in detail.Dishes)
                                    {
                                        <div class="rp-dish"><span class="n">@d.SortOrder</span><span><b>@d.DishName</b> <span style="color:#94A3B8;">· @d.Category</span></span></div>
                                    }
                                </div>
                            }
                            <div class="rp-kv"><span>Trang trí</span><b>@(detail.DecorName ?? "—") @(detail.DecorPrice.HasValue ? $"({detail.DecorPrice.Value.ToString("N0")} đ)" : "")@(string.IsNullOrWhiteSpace(detail.DecorStyle) ? "" : $" · {detail.DecorStyle}")</b></div>
                            <div class="rp-kv"><span>Dịch vụ (@detail.Services.Count)</span><b>@(detail.Services.Count == 0 ? "Không có" : string.Join("; ", detail.Services.Select(s => $"{s.ServiceName} x{s.Quantity}")))</b></div>
                            @if (!string.IsNullOrWhiteSpace(detail.SpecialRequests))
                            {
                                <div class="rp-kv"><span>Yêu cầu đặc biệt</span><b>@detail.SpecialRequests</b></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(detail.ConsultantName))
                            {
                                <div class="rp-kv"><span>NV tư vấn</span><b>@detail.ConsultantName (@(detail.ConsultantPhone ?? "—"))</b></div>
                            }
                            @if (detail.IsCancelled && !string.IsNullOrWhiteSpace(detail.CancellationReason))
                            {
                                <div class="rp-kv"><span>Lý do hủy</span><b>@detail.CancellationReason</b></div>
                            }
                        </div>
                        <div class="rp-info">
                            <h4>Tài chính</h4>
                            <div class="rp-kv"><span>Tổng dự toán</span><b>@detail.TotalAmount.ToString("N0") đ</b></div>
                            <div class="rp-kv"><span>Đã thanh toán</span><b>@detail.DepositPaid.ToString("N0") đ</b></div>
                            <div class="rp-kv"><span>Còn lại</span><b style="color:#B89758;">@detail.RemainingDebt.ToString("N0") đ</b></div>
                            <div style="font-size:11.5px;color:#94A3B8;margin-top:8px;">Số tiền đã thanh toán được tự động đối soát qua PayOS và cập nhật vào hồ sơ hợp đồng.</div>

                            <div style="margin-top:14px; padding-top:12px; border-top: 1px dashed #E2E8F0;">
                                <div style="font-size:11.5px; font-weight:700; text-transform:uppercase; color:#64748B; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center;">
                                    <span>Tiến độ các đợt thanh toán</span>
                                    <span style="font-size:11px; text-transform:none; color:#94A3B8; font-weight:normal;">(Theo hợp đồng tiệc)</span>
                                </div>
                                <div class="rp-kv" style="font-size:12px; margin-bottom:6px;">
                                    <span>Đợt 1 (Cọc 10%)</span>
                                    @if (detail.DepositPaid > 0)
                                    {
                                        <b style="color:#16A34A;"><i class="fa-solid fa-check"></i> Đã hoàn tất</b>
                                    }
                                    else
                                    {
                                        <b style="color:#DC2626;"><i class="fa-regular fa-clock"></i> Chưa cọc</b>
                                    }
                                </div>
                                <div class="rp-kv" style="font-size:12px; margin-bottom:6px;">
                                    <span>Đợt 2 (50% trước 7 ngày)</span>
                                    @if (detail.HasPaidStage2)
                                    {
                                        <b style="color:#16A34A;"><i class="fa-solid fa-check"></i> Đã thanh toán</b>
                                    }
                                    else if (detail.DepositPaid > 0)
                                    {
                                        <b style="color:#D97706;"><i class="fa-solid fa-hourglass-half"></i> Chờ thanh toán</b>
                                    }
                                    else
                                    {
                                        <span style="color:#94A3B8;">Theo tiến độ</span>
                                    }
                                </div>
                                <div class="rp-kv" style="font-size:12px;">
                                    <span>Đợt 3 (Quyết toán sau tiệc)</span>
                                    @if (detail.RemainingDebt <= 0)
                                    {
                                        <b style="color:#16A34A;"><i class="fa-solid fa-check"></i> Đã quyết toán</b>
                                    }
                                    else
                                    {
                                        <span style="color:#64748B;">Thanh toán tại sảnh sau tiệc</span>
                                    }
                                </div>
                            </div>

                            @if (!detail.IsCancelled && detail.DepositPaid <= 0)
                            {
                                @if (detail.CanCancelOnline)
                                {
                                    <div class="rp-countdown">
                                        <i class="fa-regular fa-hourglass-half"></i>
                                        Giữ chỗ hết hạn lúc <b>@detail.HoldExpiresAt.ToString("HH:mm dd/MM/yyyy")</b> (48 giờ sau khi đặt).<br />
                                        Thời gian còn lại: <b id="holdCountdown" data-expires="@detail.HoldExpiresAt.ToString("o")">--:--:--</b>
                                    </div>
                                }
                                <div style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
                                    <button type="button" class="rp-btn-gold" id="btnOpenDepositModal"
                                            onclick="RiversidePayment.open('@detail.BookingId', '@detail.BookingCode', '@detail.PhoneNumber', @Convert.ToInt64(detail.TotalAmount))">
                                        <i class="fa-solid fa-qrcode"></i> Đặt cọc giữ chỗ ngay (10%)
                                    </button>
                                    @if (detail.CanCancelOnline)
                                    {
                                        <button type="button" class="rp-btn-danger" id="openCancelModalBtn"><i class="fa-regular fa-trash-can"></i> Hủy giữ chỗ tiệc này</button>
                                    }
                                </div>
                            }
                            else if (!detail.IsCancelled && detail.DepositPaid > 0)
                            {
                                <div class="rp-contact">
                                    <i class="fa-solid fa-headset"></i>
                                    <b>Tiệc đã đặt cọc / xác nhận</b> nên không thể hủy online. Vui lòng liên hệ nhân viên @(detail.ConsultantName ?? "Riverside Palace")@(string.IsNullOrWhiteSpace(detail.ConsultantPhone) ? "" : $" ({detail.ConsultantPhone})") để được hỗ trợ đổi lịch hoặc hoàn cọc theo chính sách.
                                </div>
                                <div style="margin-top:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                                    <a class="rp-btn-gold" style="text-decoration:none;display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:700;"
                                       asp-controller="MyBooking" asp-action="DownloadInvoice"
                                       asp-route-bookingCode="@detail.BookingCode" asp-route-phone="@detail.PhoneNumber"
                                       target="_blank">
                                        <i class="fa-solid fa-file-invoice-dollar"></i> Tải hóa đơn / biên lai điện tử (Ký số X.509)
                                    </a>
                                </div>
                                @* Trạng thái và tiến độ thanh toán Đợt 2 / Đợt 3 *@
                                @if (detail.RemainingDebt <= 0)
                                {
                                    <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 12px; padding: 12px 16px; margin-top: 12px; display: flex; align-items: center; gap: 12px;">
                                        <i class="fa-solid fa-shield-check" style="color: #16A34A; font-size: 22px;"></i>
                                        <div>
                                            <div style="font-weight: 700; color: #166534; font-size: 13.5px;">Hồ sơ tiệc đã quyết toán hoàn tất 100%</div>
                                            <div style="color: #15803D; font-size: 12.5px;">Toàn bộ công nợ hợp đồng đã được thanh toán đầy đủ. Riverside Palace chúc hai bạn có một ngày trọng đại thật viên mãn!</div>
                                        </div>
                                    </div>
                                }
                                else if (detail.HasPaidStage2)
                                {
                                    <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 12px; padding: 14px 16px; margin-top: 12px; display: flex; align-items: flex-start; gap: 12px;">
                                        <i class="fa-solid fa-circle-check" style="color: #16A34A; font-size: 20px; margin-top: 2px;"></i>
                                        <div>
                                            <div style="font-weight: 700; color: #166534; font-size: 13.5px; margin-bottom: 4px;">
                                                Đã hoàn thành Thanh toán Đợt 2 (50%)
                                            </div>
                                            <div style="color: #15803D; font-size: 12.5px; line-height: 1.5;">
                                                Quý khách đã hoàn tất nghĩa vụ thanh toán <strong>Đợt 1 (10%)</strong> và <strong>Đợt 2 (50%)</strong>. Toàn bộ thực đơn, sảnh tiệc và điều phối nhân sự đã được chuẩn bị sẵn sàng cho ngày vui của hai bạn.<br />
                                                Khoản tiền còn lại (<strong>@detail.RemainingDebt.ToString("N0") đ</strong>) sẽ được <strong>quyết toán trực tiếp tại sảnh tiệc sau khi kết thúc buổi tiệc</strong> (Đợt 3).
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-top:12px; background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px; padding: 12px 16px;">
                                        <div style="font-size: 12.5px; color: #92400E; margin-bottom: 10px; line-height: 1.5;">
                                            <i class="fa-solid fa-circle-info" style="color: #D97706; margin-right: 4px;"></i>
                                            Tiến độ tiếp theo: Quý khách cần thanh toán <strong>Đợt 2 (50% giá trị hợp đồng)</strong> trước ngày tiệc 07 ngày. Quý khách có thể thanh toán trực tuyến qua VietQR PayOS ngay bên dưới.
                                        </div>
                                        <button type="button" class="rp-btn-gold" id="btnOpenContractPaymentModal" style="background: linear-gradient(135deg, #059669, #10B981); border: none; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);"
                                                onclick="RiversidePayment.openContractPayment('@detail.BookingId', '@detail.BookingCode', '@detail.PhoneNumber', @Convert.ToInt64(detail.RemainingDebt), @Convert.ToInt64(detail.TotalAmount))">
                                            <i class="fa-solid fa-credit-card"></i> Thanh toán Đợt 2 trực tuyến (VietQR PayOS)
                                        </button>
                                    </div>
                                }
                                @if (detail != null && detail.HasContract)
                                {
                                    <div style="background: #FDFBF7; border: 1px solid #EEDBB2; border-radius: 12px; padding: 14px; margin-top: 14px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #B89758;">Hợp đồng dịch vụ tiệc cưới</span>
                                            <span class="rp-code" style="font-size: 12px;">@detail.ContractCode</span>
                                        </div>
                                        <div style="font-size: 12.5px; color: #334155; line-height: 1.5; margin-bottom: 12px;">
                                            Hợp đồng chính thức xác lập quyền lợi, thực đơn, sảnh và tiến độ thanh toán tiệc cưới của quý khách.
                                        </div>
                                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                            <button type="button" class="rp-btn-gold" id="btnOpenContractModal" onclick="openCustomerContractModal()" style="padding: 9px 16px; font-size: 12.5px;">
                                                <i class="fa-regular fa-file-lines"></i> Xem hợp đồng
                                            </button>
                                            <a class="rp-btn-ghost" id="btnDownloadContractPdf" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; font-size: 12.5px; border-radius: 10px; border: 1px solid #B89758; color: #B89758; font-weight: 700;"
                                               asp-controller="MyBooking" asp-action="DownloadContractPdf"
                                               asp-route-bookingCode="@detail.BookingCode" asp-route-phone="@detail.PhoneNumber"
                                               target="_blank">
                                                <i class="fa-solid fa-file-arrow-down"></i> Tải PDF hợp đồng
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </section>

                <partial name="_ScheduleChange" model="detail" />

                <!-- MODAL HỦY GIỮ CHỖ -->
                @if (detail.CanCancelOnline && !detail.IsCancelled)
                {
                    <div class="rp-modal-backdrop" id="cancelModal" role="dialog" aria-modal="true" aria-label="Xác nhận hủy giữ chỗ">
                        <div class="rp-modal">
                            <h3>Hủy giữ chỗ @detail.BookingCode?</h3>
                            <p style="font-size:13px;color:#64748B;margin:0 0 12px;">Thao tác sẽ chuyển đơn sang <b>Đã hủy</b>, ghi lý do và <b>giải phóng lịch sảnh về Trống</b>. Không thể hoàn tác.</p>
                            <form id="cancelHoldForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@detail.BookingId" />
                                <input type="hidden" name="bookingCode" value="@detail.BookingCode" />
                                <input type="hidden" name="phoneNumber" value="@detail.PhoneNumber" />
                                <label for="cancelReason" style="font-size:12px;font-weight:700;">Lý do hủy (tối đa 500 ký tự)</label>
                                <textarea name="reason" id="cancelReason" maxlength="500" placeholder="Ví dụ: Thay đổi ngày tổ chức, trùng lịch gia đình..."></textarea>
                                <div class="rp-modal-actions">
                                    <button type="button" class="rp-btn-ghost" id="closeCancelModalBtn">Giữ lại tiệc</button>
                                    <button type="submit" class="rp-btn-confirm-danger" id="confirmCancelBtn">Xác nhận hủy giữ chỗ</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            else if (string.IsNullOrWhiteSpace(lookupError))
            {
                <div class="rp-alert-empty">
                    <i class="fa-regular fa-envelope-open" style="font-size:26px;color:#B89758;"></i>
                    <p style="margin:10px 0 4px;font-weight:700;color:#111822;">Chưa có hồ sơ nào được hiển thị</p>
                    <p style="margin:0;">Nhập mã đặt tiệc cùng email hoặc số điện thoại ở biểu mẫu phía trên rồi bấm <b>“Tra cứu hồ sơ tiệc cưới”</b>.</p>
                </div>
            }

            <!-- DANH SÁCH CŨ (tương thích /MyBookings) -->
            @if (myBookings.Count > 0)
            {
                <section class="rp-card" aria-label="Danh sách đơn theo SĐT">
                    <h2 style="font-family:'Playfair Display',serif;font-size:18px;margin:0 0 4px;">Đơn tiệc theo số điện thoại của bạn (@myBookings.Count)</h2>
                    <p class="rp-sub">Danh sách các tiệc cưới liên kết với số điện thoại của bạn — bấm chọn mã để xem chi tiết đầy đủ.</p>
                    <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px;">
                        @foreach (var b in myBookings)
                        {
                            <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;border:1px solid #E9E2D3;border-radius:12px;padding:10px 14px;font-size:13px;">
                                <span><span class="rp-code" style="font-size:12px;">@b.BookingCode</span> · @b.HallName · @b.Shift @b.EventDate.ToString("dd/MM/yyyy") · @b.Status</span>
                                <span>
                                    <a asp-controller="MyBooking" asp-action="Index" asp-route-bookingCode="@b.BookingCode" asp-route-phone="@b.PhoneNumber" style="color:#B89758;font-weight:700;">Xem chi tiết →</a>
                                    <a href="/danh-gia/chu-tiec/@Uri.EscapeDataString(b.BookingCode)" style="margin-left:14px;color:#8b642a;font-weight:700;">Đánh giá buổi tiệc</a>
                                </span>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
        @if (detail != null && detail.HasContract)
        {
            <div class="rp-modal-backdrop" id="contractDetailModal" role="dialog" aria-modal="true" aria-label="Chi tiết hợp đồng đặt tiệc">
                <div class="rp-modal" style="max-width: 680px; max-height: 85vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px; margin-bottom: 16px;">
                        <div>
                            <span class="rp-eyebrow">HỢP ĐỒNG KÝ KẾT</span>
                            <h3 style="margin: 2px 0 0; font-size: 20px;">Hợp Đồng Dịch Vụ Tiệc Cưới</h3>
                        </div>
                        <span class="rp-code">@detail.ContractCode</span>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; background: #FAF8F5; border: 1px solid #E9E2D3; border-radius: 12px; padding: 14px; margin-bottom: 16px; font-size: 12.5px;">
                        <div>
                            <span style="color: #64748B; display: block; font-size: 11px;">Bên A (Khách hàng):</span>
                            <strong>@detail.CustomerName</strong>
                            <div style="color: #64748B;">@MaskPhoneNumber(detail.PhoneNumber)</div>
                        </div>
                        <div>
                            <span style="color: #64748B; display: block; font-size: 11px;">Bên B (Đơn vị tổ chức):</span>
                            <strong>Trung Tâm Hội Nghị Tiệc Cưới Riverside Palace</strong>
                            <div style="color: #64748B;">360D Bến Vân Đồn, Q.4, TP.HCM</div>
                        </div>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <h4 style="font-size: 12px; text-transform: uppercase; color: #B89758; margin-bottom: 6px;">Nội Dung Hợp Đồng</h4>
                        <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 12px; font-size: 12.5px; line-height: 1.6; white-space: pre-wrap; color: #334155;">@(detail.ContractContent ?? "Hợp đồng dịch vụ tiệc cưới được thiết lập theo thông tin đặt tiệc.")</div>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <h4 style="font-size: 12px; text-transform: uppercase; color: #B89758; margin-bottom: 6px;">Điều Khoản &amp; Tiến Độ Thanh Toán</h4>
                        <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 12px; font-size: 12.5px; line-height: 1.6; white-space: pre-wrap; color: #334155;">@(detail.PaymentTerms ?? "Đợt 1: Đặt cọc 10%\nĐợt 2: Thanh toán 50% trước ngày tiệc 07 ngày\nĐợt 3: Quyết toán và phát sinh sau tiệc")</div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #E2E8F0; padding-top: 14px;">
                        <a class="rp-btn-gold" style="text-decoration: none; font-size: 12.5px; padding: 10px 18px;"
                           asp-controller="MyBooking" asp-action="DownloadContractPdf"
                           asp-route-bookingCode="@detail.BookingCode" asp-route-phone="@detail.PhoneNumber"
                           target="_blank">
                            <i class="fa-solid fa-file-arrow-down"></i> Tải bản PDF chính thức
                        </a>
                        <button type="button" class="rp-btn-ghost" onclick="closeCustomerContractModal()">Đóng</button>
                    </div>
                </div>
            </div>
        }
    </main>
    <partial name="_PublicFooter" />
</div>

<partial name="_PaymentDepositModal" />

@section Scripts {
    <script>
        function openCustomerContractModal() {
            var m = document.getElementById('contractDetailModal');
            if (m) m.classList.add('open');
        }
        function closeCustomerContractModal() {
            var m = document.getElementById('contractDetailModal');
            if (m) m.classList.remove('open');
        }
    </script>
    <script src="~/js/public-site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <script src="~/js/payment-deposit.js" asp-append-version="true"></script>
    <script src="~/js/schedule-change.js" asp-append-version="true"></script>
    <script>
        (function () {
            var codeInput = document.getElementById('bookingCodeInput');
            var phoneInput = document.getElementById('phoneInput');
            var codeErr = document.getElementById('bookingCodeError');
            var phoneErr = document.getElementById('phoneError');
            var form = document.getElementById('lookupForm');
            var codeRe = /^DT-\d{8}-[A-Z0-9]{4,}$/;
            var contactRe = /^(0\d{9}|[^\s@@]+@@[^\s@@]+\.[^\s@@]+)$/i;
            function normCode() { if (codeInput) codeInput.value = (codeInput.value || '').trim().toUpperCase(); }
            function validateLive() {
                if (codeInput && codeErr) codeErr.style.display = (codeInput.value.trim() === '' || codeRe.test(codeInput.value.trim().toUpperCase())) ? 'none' : 'block';
                if (phoneInput && phoneErr) phoneErr.style.display = (phoneInput.value.trim() === '' || contactRe.test(phoneInput.value.trim())) ? 'none' : 'block';
            }
            if (codeInput) { codeInput.addEventListener('input', validateLive); codeInput.addEventListener('blur', function () { normCode(); validateLive(); }); }
            if (phoneInput) {
                phoneInput.addEventListener('input', validateLive);
                phoneInput.addEventListener('blur', function () {
                    phoneInput.value = (phoneInput.value || '').trim();
                    validateLive();
                });
            }
            if (form) {
                form.addEventListener('submit', function (e) {
                    normCode();
                    var okCode = codeInput && codeRe.test((codeInput.value || '').trim());
                    var okPhone = phoneInput && contactRe.test((phoneInput.value || '').trim());
                    validateLive();
                    if (!okCode || !okPhone) {
                        e.preventDefault();
                        if (!okCode && codeInput) codeInput.focus();
                        else if (phoneInput) phoneInput.focus();
                    }
                });
            }
            // Countdown 48h
            var cd = document.getElementById('holdCountdown');
            if (cd && cd.dataset.expires) {
                var exp = new Date(cd.dataset.expires).getTime();
                function tick() {
                    var diff = exp - Date.now();
                    if (isNaN(diff) || diff <= 0) { cd.textContent = 'Đã hết hạn giữ chỗ'; return; }
                    var h = Math.floor(diff / 3600000), m = Math.floor((diff % 3600000) / 60000), s = Math.floor((diff % 60000) / 1000);
                    cd.textContent = h + ' giờ ' + String(m).padStart(2, '0') + ' phút ' + String(s).padStart(2, '0') + ' giây';
                }
                tick(); setInterval(tick, 1000);
            }
            // Modal hủy giữ chỗ
            var modal = document.getElementById('cancelModal');
            var openBtn = document.getElementById('openCancelModalBtn');
            var closeBtn = document.getElementById('closeCancelModalBtn');
            var cancelForm = document.getElementById('cancelHoldForm');
            if (openBtn && modal) openBtn.addEventListener('click', function () { modal.classList.add('open'); });
            if (closeBtn && modal) closeBtn.addEventListener('click', function () { modal.classList.remove('open'); });
            if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) modal.classList.remove('open'); });
            if (cancelForm) {
                cancelForm.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var reason = document.getElementById('cancelReason');
                    if (reason && reason.value.trim().length > 500) { alert('Lý do hủy không được vượt quá 500 ký tự.'); return; }
                    if (!confirm('Xác nhận HỦY giữ chỗ và giải phóng lịch sảnh?')) return;
                    var btn = document.getElementById('confirmCancelBtn');
                    if (btn) { btn.disabled = true; btn.textContent = 'Đang hủy...'; }
                    try {
                        var fd = new FormData(cancelForm);
                        var token = cancelForm.querySelector('input[name="__RequestVerificationToken"]');
                        var res = await fetch('/MyBooking/CancelHold', {
                            method: 'POST',
                            body: fd,
                            headers: token ? { 'RequestVerificationToken': token.value } : {}
                        });
                        var result = await res.json();
                        if (result.success) { alert(result.message || 'Đã hủy giữ chỗ thành công và giải phóng lịch sảnh.'); window.location.reload(); }
                        else { alert(result.message || 'Không thể hủy giữ chỗ lúc này.'); }
                    } catch (err) { alert('Lỗi kết nối khi gửi yêu cầu hủy giữ chỗ.'); }
                    finally { if (btn) { btn.disabled = false; btn.textContent = 'Xác nhận hủy giữ chỗ'; } }
                });
            }
        })();
    </script>
}
