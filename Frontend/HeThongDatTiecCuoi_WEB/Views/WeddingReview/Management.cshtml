@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng quan đánh giá";
    var o = (System.Text.Json.JsonElement)ViewBag.Overview;
    var bookings = o.GetProperty("bookings").EnumerateArray().ToList();
    var halls = o.GetProperty("halls").EnumerateArray().ToList();
    var attention = o.GetProperty("attentionReviews").EnumerateArray().ToList();
    string Metric(string name, string suffix = "") => o.GetProperty(name).ValueKind == System.Text.Json.JsonValueKind.Null ? ("0" + suffix) : o.GetProperty(name).GetDouble().ToString("0.0") + suffix;
}
@section Styles {
    <link rel="stylesheet" href="~/css/coordinator-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hall-manager-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wedding-reviews.css" asp-append-version="true" />
}
<main class="incident-page hall-incident-page manager-incident-page review-page">
 <header class="incident-header manager-incident-hero review-hero"><div><span class="incident-eyebrow">CHẤT LƯỢNG DỊCH VỤ</span><h1>Tổng quan đánh giá</h1><p>Số liệu tổng quan và danh sách hồ sơ đặt tiệc trong phạm vi bộ lọc và quyền truy cập hiện tại.</p></div><button type="button" class="incident-primary" onclick="location.reload()"><i class="fa-solid fa-rotate"></i><span>Làm mới số liệu</span></button></header>
 <section class="incident-kpis hall-kpis manager-incident-kpis review-kpis overview-six">
  <article><span class="kpi-icon all"><i class="fa-solid fa-champagne-glasses"></i></span><div><small>Tổng số tiệc</small><strong>@o.GetProperty("totalBookings").GetInt32()</strong><span>Booking phù hợp</span></div></article>
  <article><span class="kpi-icon processing"><i class="fa-solid fa-comments"></i></span><div><small>Đã có đánh giá</small><strong>@o.GetProperty("reviewedBookings").GetInt32()</strong><span>Không nhân bản theo lượt</span></div></article>
  <article><span class="kpi-icon resolved"><i class="fa-solid fa-star"></i></span><div><small>Tổng lượt đánh giá</small><strong>@o.GetProperty("totalReviews").GetInt32()</strong><span>Phản hồi hợp lệ</span></div></article>
  <article><span class="kpi-icon average"><i class="fa-solid fa-ranking-star"></i></span><div><small>Điểm trung bình</small><strong class="metric-text">@Metric("averageScore", "/5")</strong><span>Dựa trên điểm tổng thể</span></div></article>
  <article><span class="kpi-icon positive"><i class="fa-solid fa-thumbs-up"></i></span><div><small>Tỷ lệ tích cực</small><strong class="metric-text">@Metric("positiveRate", "%")</strong><span>Đánh giá 4–5 sao</span></div></article>
  <article><span class="kpi-icon negative"><i class="fa-solid fa-thumbs-down"></i></span><div><small>Tỷ lệ tiêu cực</small><strong class="metric-text">@Metric("negativeRate", "%")</strong><span>Đánh giá 1–2 sao</span></div></article>
 </section>
 @if(attention.Count > 0){<section class="incident-panel manager-incident-panel review-panel attention-panel"><header class="incident-panel-head"><div><h2>Phản hồi cần chú ý</h2><p>Các đánh giá 1–2 sao gần đây nhất.</p></div><span class="attention-pill"><i class="fa-solid fa-triangle-exclamation"></i>@attention.Count phản hồi</span></header><div class="attention-list">@foreach(var r in attention){var bookingId=r.GetProperty("bookingId").GetInt32();<article><span class="attention-score">@r.GetProperty("score").GetInt32()<i class="fa-solid fa-star"></i></span><div><strong>@r.GetProperty("bookingCode").GetString() · @r.GetProperty("hallName").GetString()</strong><p>@(r.GetProperty("comment").ValueKind==System.Text.Json.JsonValueKind.Null?"Không có bình luận.":r.GetProperty("comment").GetString())</p><time>@r.GetProperty("reviewedAt").GetDateTime().ToString("dd/MM/yyyy HH:mm")</time></div><a class="review-detail-link" href="/danh-gia/quan-ly/@bookingId">Xem chi tiết</a></article>}</div></section>}
 <section class="incident-panel manager-incident-panel review-panel booking-review-panel">
  <header class="incident-panel-head"><div><h2>Danh sách tiệc</h2><p>Chọn một tiệc để mở trang thống kê đánh giá riêng của sảnh.</p></div><span class="scope-pill manager-scope-pill"><i class="fa-solid fa-shield-halved"></i>Theo quyền truy cập</span></header>
  <form method="get" class="incident-filters overview-filters"><label class="incident-search"><i class="fa-solid fa-magnifying-glass"></i><input name="search" value="@Context.Request.Query["search"]" placeholder="Mã Booking hoặc tên sảnh..." /></label><label><span>Sảnh</span><select name="hallId"><option value="">Tất cả sảnh</option>@foreach(var h in halls){var hallId=h.GetProperty("hallId").GetInt32();<option value="@hallId" selected="@(Context.Request.Query["hallId"]==hallId.ToString())">@h.GetProperty("hallName").GetString()</option>}</select></label><label><span>Từ ngày tổ chức</span><input type="date" name="fromDate" value="@Context.Request.Query["fromDate"]" /></label><label><span>Đến ngày tổ chức</span><input type="date" name="toDate" value="@Context.Request.Query["toDate"]" /></label><div class="overview-filter-actions"><button type="submit" class="incident-filter-button"><i class="fa-solid fa-filter"></i>Lọc</button><a href="/danh-gia/quan-ly" class="incident-reset" title="Tải lại danh sách / Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a></div></form>
  <div class="incident-table-wrap"><table class="incident-table hall-incident-table manager-incident-table review-table"><thead><tr><th>Mã Booking</th><th>Sảnh</th><th>Ngày tổ chức</th><th>Trạng thái QR</th><th>Đánh giá</th><th>Điểm TB</th><th class="actions">Thao tác</th></tr></thead><tbody>@foreach(var b in bookings){var id=b.GetProperty("bookingId").GetInt32();var state=b.GetProperty("qrState").GetString();var label=state=="Pending"?"Chờ kích hoạt":state=="Active"?"Đang hoạt động":state=="Expired"?"Hết hạn":"Bị khóa";<tr><td><a class="incident-code" href="/danh-gia/quan-ly/@id">@b.GetProperty("bookingCode").GetString()</a></td><td><span class="hall-cell"><i class="fa-regular fa-building"></i>@b.GetProperty("hallName").GetString()</span></td><td><time>@b.GetProperty("eventDate").GetDateTime().ToString("dd/MM/yyyy")<small>@b.GetProperty("shift").GetString()</small></time></td><td><span class="review-status @state?.ToLowerInvariant()">@label</span></td><td><span class="review-count">@b.GetProperty("reviewCount").GetInt32()</span></td><td><span class="review-average">@(b.GetProperty("averageScore").ValueKind==System.Text.Json.JsonValueKind.Null ? "0" : b.GetProperty("averageScore").GetDouble().ToString("0.0"))<small>/5</small></span></td><td class="actions"><a class="icon-action" href="/danh-gia/quan-ly/@id" title="Xem chi tiết đánh giá"><i class="fa-regular fa-eye"></i></a></td></tr>}</tbody></table>@if(bookings.Count==0){<div class="incident-empty"><span><i class="fa-regular fa-star"></i></span><h3>Không có Booking phù hợp</h3><p>Hãy thay đổi bộ lọc để xem dữ liệu.</p></div>}</div>
  <footer class="incident-footer"><span>Trang @o.GetProperty("page").GetInt32() / @o.GetProperty("totalPages").GetInt32()</span>@if(o.GetProperty("totalPages").GetInt32()>1){<nav class="incident-pagination">@for(var p=1;p<=o.GetProperty("totalPages").GetInt32();p++){<a class="@(p==o.GetProperty("page").GetInt32()?"active":null)" href="@Context.Request.Path?search=@Context.Request.Query["search"]&hallId=@Context.Request.Query["hallId"]&fromDate=@Context.Request.Query["fromDate"]&toDate=@Context.Request.Query["toDate"]&page=@p">@p</a>}</nav>}</footer>
 </section>
</main>
