@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết đánh giá sảnh";
    var d = (System.Text.Json.JsonElement)ViewBag.Statistics;
    var reviews = d.GetProperty("reviews").EnumerateArray().ToList();
    var total = d.GetProperty("totalReviews").GetInt32();
    var qrState = d.GetProperty("qrState").GetString();
    var qrLabel = qrState == "Pending" ? "Chờ kích hoạt" : qrState == "Active" ? "Đang hoạt động" : qrState == "Expired" ? "Hết hạn" : "Bị khóa";
    string Number(string name, string suffix = "") => d.GetProperty(name).ValueKind == System.Text.Json.JsonValueKind.Null ? "—" : d.GetProperty(name).GetDouble().ToString("0.0") + suffix;
}
@section Styles {
    <link rel="stylesheet" href="~/css/coordinator-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hall-manager-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/manager-incidents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wedding-reviews.css" asp-append-version="true" />
}
<main class="incident-page hall-incident-page manager-incident-page review-page">
 <a class="review-back" href="/danh-gia/quan-ly"><i class="fa-solid fa-arrow-left"></i>Quay lại danh sách đánh giá</a>
 <header class="incident-header manager-incident-hero review-detail-hero"><div><span class="incident-eyebrow">CHI TIẾT ĐÁNH GIÁ SẢNH</span><h1>@d.GetProperty("hallName").GetString()</h1><p>Booking <strong>@d.GetProperty("bookingCode").GetString()</strong> · @d.GetProperty("eventDate").GetDateTime().ToString("dd/MM/yyyy") · @d.GetProperty("shift").GetString()</p></div><span class="review-status @qrState?.ToLowerInvariant()">@qrLabel</span></header>

 <section class="detail-metric-grid">
  <article class="detail-metric"><small>Điểm trung bình</small><strong>@Number("averageScore", "/5")</strong><span>Điểm tổng thể</span></article>
  <article class="detail-metric"><small>Tổng lượt đánh giá</small><strong>@total</strong><span>@d.GetProperty("guestReviews").GetInt32() khách mời · @d.GetProperty("hostReviews").GetInt32() chủ tiệc</span></article>
  <article class="detail-metric positive"><small>Mức hài lòng</small><strong>@Number("satisfactionRate", "%")</strong><span>@d.GetProperty("positiveCount").GetInt32() đánh giá tích cực</span></article>
  <article class="detail-metric neutral"><small>Trung lập</small><strong>@d.GetProperty("neutralCount").GetInt32()</strong><span>Đánh giá 3 sao</span></article>
  <article class="detail-metric negative"><small>Tiêu cực</small><strong>@d.GetProperty("negativeCount").GetInt32()</strong><span>Đánh giá 1–2 sao</span></article>
  <article class="detail-metric"><small>Đối tượng phản hồi</small><strong>@d.GetProperty("guestReviews").GetInt32() / @d.GetProperty("hostReviews").GetInt32()</strong><span>Khách mời / Chủ tiệc</span></article>
 </section>

 <section class="review-stat-grid detail-charts">
  <article class="incident-panel manager-incident-panel review-panel"><header class="incident-panel-head"><div><h2>Phân bố đánh giá theo số sao</h2><p>Số lượt và tỷ lệ trên tổng đánh giá của tiệc này.</p></div></header><div class="rating-bars">@for(var star=5;star>=1;star--){var count=d.GetProperty("ratingDistribution").GetProperty(star.ToString()).GetInt32();var width=total==0?0:count*100/total;var tone=star>=4?"positive":star==3?"neutral":"negative";<div class="rating-row @tone"><span>@star <i class="fa-solid fa-star"></i></span><div><i style="width:@width%"></i></div><strong>@count <small>(@(total==0?"—":$"{width}%"))</small></strong></div>}@if(total==0){<p class="chart-empty">Chưa có dữ liệu đánh giá.</p>}</div></article>
  <article class="incident-panel manager-incident-panel review-panel"><header class="incident-panel-head"><div><h2>Điểm trung bình theo tiêu chí</h2><p>Chỉ tính những tiêu chí đã được người dùng chấm điểm.</p></div></header><div class="criteria-chart">@foreach(var item in new[]{("hall","Chất lượng sảnh","fa-building"),("food","Món ăn","fa-utensils"),("service","Phục vụ","fa-bell-concierge"),("sound","Âm thanh","fa-volume-high"),("lighting","Ánh sáng","fa-lightbulb")}){var value=d.GetProperty("criteria").GetProperty(item.Item1);var score=value.ValueKind==System.Text.Json.JsonValueKind.Null?0d:value.GetDouble();<div class="criteria-column"><strong>@score.ToString("0.0")</strong><div><i style="height:@(score*20)%"></i></div><span><i class="fa-solid @item.Item3"></i>@item.Item2</span></div>}</div></article>
 </section>

 <section class="incident-panel manager-incident-panel review-panel detail-feedback">
  <header class="incident-panel-head"><div><h2>Phản hồi của khách hàng</h2><p>Nội dung và điểm thành phần của từng lượt đánh giá.</p></div><label class="feedback-filter"><select id="feedbackFilter"><option value="all">Tất cả phản hồi</option><option value="positive">Tích cực</option><option value="neutral">Trung lập</option><option value="negative">Tiêu cực</option></select></label></header>
  @if(reviews.Count==0){<div class="incident-empty"><span><i class="fa-regular fa-comment-dots"></i></span><h3>Chưa có phản hồi</h3><p>Các đánh giá mới sẽ xuất hiện tại đây.</p></div>}
  else{<div class="comment-list">@foreach(var r in reviews){var classification=r.GetProperty("classification").GetString()?.ToLowerInvariant()??"neutral";var label=classification=="positive"?"Tích cực":classification=="negative"?"Tiêu cực":"Trung lập";<article class="review-comment" data-classification="@classification"><span class="comment-avatar"><i class="fa-regular fa-user"></i></span><div class="comment-content"><header><div><span class="reviewer-badge">@r.GetProperty("reviewerType").GetString()</span><span class="sentiment-badge @classification">@label</span></div><time>@r.GetProperty("reviewedAt").GetDateTime().ToString("dd/MM/yyyy HH:mm")</time></header><div class="comment-stars">@for(var star=1;star<=5;star++){<i class="@(star<=r.GetProperty("overallScore").GetInt32()?"fa-solid":"fa-regular") fa-star"></i>}<b>@r.GetProperty("overallScore").GetInt32()/5</b></div><div class="comment-scores">@foreach(var score in new[]{("hallScore","Sảnh"),("foodScore","Món ăn"),("serviceScore","Phục vụ"),("soundScore","Âm thanh"),("lightingScore","Ánh sáng")}){var value=r.GetProperty(score.Item1);if(value.ValueKind!=System.Text.Json.JsonValueKind.Null){<span>@score.Item2: @value.GetInt32()/5</span>}}</div><p>@(r.GetProperty("comment").ValueKind==System.Text.Json.JsonValueKind.Null?"Không có bình luận.":r.GetProperty("comment").GetString())</p></div></article>}</div>}
 </section>
</main>
<script>
 document.getElementById('feedbackFilter')?.addEventListener('change', function () {
   document.querySelectorAll('[data-classification]').forEach(item => item.hidden = this.value !== 'all' && item.dataset.classification !== this.value);
 });
</script>
