                            </div>

                            <!-- Hạng mục combo -->
                            <div class="space-y-2.5 text-xs">
                                <div class="p-3 bg-white rounded-2xl border border-slate-100">
                                    <div class="flex justify-between font-bold text-slate-800">
                                        <span><i class="fa-solid fa-archway text-[#B89758] mr-1.5"></i>${hallName}</span>
                                        <span>${hallPrice} đ</span>
                                    </div>
                                    <span class="text-[11px] text-slate-500 block mt-0.5">Sức chứa: ${hallCap} bàn • Hệ thống đèn chiếu cao cấp</span>
