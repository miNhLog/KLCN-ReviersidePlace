                            <button type="button" onclick="customerRegisterBooking(${c.hallId ?? c.HallId}, '${hallName}', '${req.coupleName}', '${req.phoneNumber}', '${req.eventDate}', '${req.shift}', ${req.officialTableCount + req.spareTableCount})" class="w-full py-3 px-4 rounded-xl font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md ${isBest ? 'bg-[#B89758] hover:bg-[#8C6D32] text-white hover:shadow-lg' : 'bg-[#1E293B] hover:bg-slate-900 text-white'}">
