        function customerRegisterBooking(hallId, hallName, coupleName, phone, eventDate, shift, totalTables) {
            if (confirm(`Xác nhận gửi thông tin đăng ký giữ chỗ ${hallName} (${shift} ngày ${eventDate}) cho cặp đôi ${coupleName}? Chuyên viên Riverside Palace sẽ liên hệ lại trong vòng 30 phút.`)) {
                alert("Cảm ơn hai bạn! Yêu cầu giữ chỗ gói tiệc đã được gửi thành công đến bộ phận tư vấn của Riverside Palace.");
