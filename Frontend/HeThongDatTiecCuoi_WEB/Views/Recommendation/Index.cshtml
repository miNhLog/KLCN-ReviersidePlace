                                <ul class="text-[11px] text-slate-600 space-y-1">
                                    ${reasonsHtml}
                                </ul>
                            </div>
                        </div>

                        <!-- Footer: Tổng tiền & Nút đăng ký -->
                        <div class="pt-5 mt-5 border-t border-slate-200/80">
                            <div class="flex items-baseline justify-between mb-1">
                                <span class="text-xs text-slate-500 font-medium">Dự toán trọn gói:</span>
