@model HeThongDatTiecCuoi_WEB.Models.ManagerContractPayment.ManagerContractPaymentPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Hợp đồng & Thanh toán";
    Layout = "_AdminLayout";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => $"{value.ToString("N0", vi)} đ";
    var totalContracts = Model.Contracts.Statistics.TotalContracts;
    var activePercent = totalContracts > 0 ? Math.Round(Model.Contracts.Statistics.ActiveContracts * 100d / totalContracts) : 0d;
    var awaitingPercent = totalContracts > 0 ? Math.Round(Model.Contracts.Statistics.AwaitingPaymentContracts * 100d / totalContracts) : 0d;
    string Badge(string code) => code.ToUpperInvariant() switch
    {
        "ACTIVE" => "active",
        "COMPLETED" => "completed",
        "CANCELLED" => "cancelled",
        _ => "draft"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/manager-contract-payment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-deposit.css" asp-append-version="true" />
    <style>
    </style>
}

<div class="contract-payment-page" data-page-root data-initial-booking-id="@Context.Request.Query["bookingId"]" data-initial-contract-id="@Context.Request.Query["contractId"]" data-open-create="@Context.Request.Query["openCreate"]">
    <form id="cpAntiforgery" hidden>@Html.AntiForgeryToken()</form>

    <header class="cp-page-head manager-section-header">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i> HỢP ĐỒNG &amp; TÀI CHÍNH</span>
            <h1>Hợp đồng &amp; thanh toán</h1>
            <p>Quản lý hợp đồng và theo dõi các khoản thanh toán của khách hàng.</p>
        </div>
        <button type="button" class="cp-primary admin-create-button" id="openCreateContract"><i class="fa-solid fa-plus"></i>Tạo hợp đồng</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string))
    {
        <div class="cp-error-banner">@ViewBag.ErrorMessage</div>
    }

    <section class="cp-kpis" aria-label="Tổng quan hợp đồng">
        <article class="cp-kpi cp-kpi--contracts">
            <div class="cp-kpi-top">
                <span class="cp-kpi-label">Tổng hợp đồng</span>
                <span class="cp-kpi-icon"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></span>
            </div>
            <div class="cp-kpi-body">
                <strong id="kpiTotal">@Model.Contracts.Statistics.TotalContracts</strong>
            </div>
            <span class="cp-kpi-detail">Tất cả hợp đồng trong hệ thống</span>
        </article>
        <article class="cp-kpi cp-kpi--active">
            <div class="cp-kpi-top">
                <span class="cp-kpi-label">Hợp đồng đang hiệu lực</span>
                <span class="cp-kpi-icon"><i class="fa-regular fa-circle-check" aria-hidden="true"></i></span>
            </div>
            <div class="cp-kpi-body">
                <strong id="kpiActive">@Model.Contracts.Statistics.ActiveContracts</strong>
            </div>
            <div class="cp-kpi-progress" aria-label="Tỷ lệ hợp đồng đang hiệu lực">
                <span class="cp-kpi-progress-track"><span id="kpiActiveBar" style="width: @(activePercent.ToString("0", CultureInfo.InvariantCulture))%"></span></span>
                <span class="cp-kpi-detail"><b id="kpiActivePercent">@activePercent.ToString("0")%</b> trên tổng số hợp đồng</span>
            </div>
        </article>
        <article class="cp-kpi cp-kpi--pending">
            <div class="cp-kpi-top">
                <span class="cp-kpi-label">Chờ thanh toán</span>
                <span class="cp-kpi-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
            </div>
            <div class="cp-kpi-body">
                <strong id="kpiAwaiting">@Model.Contracts.Statistics.AwaitingPaymentContracts</strong>
            </div>
            <div class="cp-kpi-progress" aria-label="Tỷ lệ hợp đồng chờ thanh toán">
                <span class="cp-kpi-progress-track"><span id="kpiAwaitingBar" style="width: @(awaitingPercent.ToString("0", CultureInfo.InvariantCulture))%"></span></span>
                <span class="cp-kpi-detail"><b id="kpiAwaitingPercent">@awaitingPercent.ToString("0")%</b> trên tổng số hợp đồng</span>
            </div>
        </article>
        <article class="cp-kpi cp-kpi--revenue cp-kpi-revenue">
            <div class="cp-kpi-top">
                <span class="cp-kpi-label">Doanh thu đã thu</span>
                <span class="cp-kpi-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
            </div>
            <div class="cp-kpi-body">
                <strong id="kpiRevenue"><span class="cp-kpi-revenue-value">@Model.Contracts.Statistics.TotalCollectedRevenue.ToString("N0", vi)</span><small>đ</small></strong>
            </div>
            <span class="cp-kpi-detail">Tổng số tiền đã ghi nhận</span>
        </article>
    </section>

    <section class="cp-card">
        <nav class="cp-tabs" aria-label="Hợp đồng và thanh toán">
            <button type="button" class="cp-tab active" data-main-tab="contracts"><i class="fa-regular fa-file-lines"></i> Hợp đồng</button>
            <button type="button" class="cp-tab" data-main-tab="payments"><i class="fa-solid fa-coins"></i> Thanh toán</button>
        </nav>

        <div id="contractTab">
            <div class="cp-toolbar">
                <label class="cp-field"><i class="fa-solid fa-magnifying-glass"></i><input class="cp-input" id="contractKeyword" placeholder="Mã hợp đồng, booking, khách hàng, SĐT..." /></label>
                <select class="cp-select" id="contractStatus" aria-label="Trạng thái hợp đồng"><option value="ALL">Tất cả trạng thái</option><option value="DRAFT">Bản nháp</option><option value="ACTIVE">Có hiệu lực</option><option value="COMPLETED">Hoàn tất</option><option value="CANCELLED">Đã hủy</option></select>
                <input class="cp-input" id="contractFromDate" type="date" aria-label="Từ ngày" />
                <input class="cp-input" id="contractToDate" type="date" aria-label="Đến ngày" />
            </div>
            <div class="cp-table-wrap">
                <table class="cp-table">
                    <thead><tr><th>Mã hợp đồng</th><th>Khách hàng</th><th>Mã booking</th><th>Ngày tạo</th><th style="text-align:right">Tổng giá trị</th><th>Trạng thái</th><th>Tiến độ thanh toán</th><th>Thao tác</th></tr></thead>
                    <tbody id="contractRows">
                    @if (Model.Contracts.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="cp-empty">Chưa có hợp đồng phù hợp.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Contracts.Items)
                        {
                            var width = Math.Clamp(item.PaymentPercentage, 0m, 100m);
                            <tr data-contract-id="@item.ContractId">
                                <td><span class="cp-code">@item.ContractCode</span></td>
                                <td class="cp-customer"><strong>@item.CustomerName</strong><small>@item.CustomerPhone</small></td>
                                <td><span class="cp-code">@item.BookingCode</span></td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="cp-money">@Money(item.TotalValue)</td>
                                <td><span class="cp-badge @Badge(item.StatusCode)">@item.StatusName</span></td>
                                <td><div class="cp-progress"><div class="cp-progress-track"><div class="cp-progress-bar" style="width:@width.ToString(CultureInfo.InvariantCulture)%"></div></div><div class="cp-progress-meta"><span>Đã thu @Money(item.PaidAmount)</span><b>@item.PaymentPercentage.ToString("0.#")%</b></div>@if(item.HasPaymentInconsistency){<div class="cp-warning">Thanh toán vượt giá trị</div>}</div></td>
                                <td><button type="button" class="cp-icon-btn" data-view-contract="@item.ContractId" title="Xem chi tiết"><i class="fa-regular fa-eye"></i></button></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <footer class="cp-pagination"><span id="contractPageInfo">Trang @Math.Max(1, Model.Contracts.Page) / @Math.Max(1, Model.Contracts.TotalPages) · @Model.Contracts.TotalItems hợp đồng</span><div class="cp-pages" id="contractPages"></div></footer>
        </div>

        <div id="paymentTab" class="cp-hidden">
            <div class="cp-toolbar" style="grid-template-columns:minmax(230px,1.6fr) repeat(4,minmax(130px,.65fr))">
                <label class="cp-field"><i class="fa-solid fa-magnifying-glass"></i><input class="cp-input" id="paymentKeyword" placeholder="Giao dịch, hợp đồng, booking, khách hàng..." /></label>
                <select class="cp-select" id="paymentType"><option value="ALL">Tất cả loại</option><option>Đặt cọc</option><option>Thanh toán đợt</option><option>Quyết toán</option></select>
                <select class="cp-select" id="paymentStatus"><option value="ALL">Tất cả trạng thái</option><option value="PENDING">Chờ xử lý</option><option value="SUCCESS">Thành công</option><option value="FAILED">Thất bại</option><option value="CANCELLED">Đã hủy</option></select>
                <input class="cp-input" id="paymentFromDate" type="date" aria-label="Từ ngày" />
                <input class="cp-input" id="paymentToDate" type="date" aria-label="Đến ngày" />
            </div>
            <div class="cp-table-wrap"><table class="cp-table"><thead><tr><th>Mã giao dịch</th><th>Mã hợp đồng</th><th>Booking</th><th>Khách hàng</th><th>Loại thanh toán</th><th style="text-align:right">Số tiền</th><th>Ngày thanh toán</th><th>Phương thức</th><th>Trạng thái</th></tr></thead><tbody id="paymentRows"><tr><td colspan="9" class="cp-empty">Chọn tab Thanh toán để tải dữ liệu.</td></tr></tbody></table></div>
            <footer class="cp-pagination"><span id="paymentPageInfo">Payment chỉ hiển thị và không thể chỉnh sửa.</span><div class="cp-pages" id="paymentPages"></div></footer>
        </div>
    </section>
</div>

<div class="cp-overlay" id="drawerOverlay"></div>
<aside class="cp-drawer" id="contractDrawer" aria-label="Chi tiết hợp đồng">
    <header class="cp-drawer-head cp-contract-detail-head">
        <div class="cp-drawer-title">
            <span class="cp-detail-title-icon" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></span>
            <div class="cp-detail-title-copy"><span class="cp-detail-eyebrow">CHI TIẾT HỢP ĐỒNG</span><h2 id="drawerCode">Hợp đồng</h2><small id="drawerMeta"></small></div>
        </div>
        <div class="cp-detail-head-actions"><span id="drawerStatus"></span><button type="button" class="cp-drawer-close" id="closeDrawer" aria-label="Đóng chi tiết hợp đồng"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
    </header>
    <nav class="cp-drawer-tabs" aria-label="Nội dung chi tiết hợp đồng">
        <button type="button" class="active" data-drawer-tab="general"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><span>Hợp đồng</span></button>
        <button type="button" data-drawer-tab="booking"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i><span>Booking</span></button>
        <button type="button" data-drawer-tab="payments"><i class="fa-solid fa-coins" aria-hidden="true"></i><span>Thanh toán</span></button>
        <button type="button" data-drawer-tab="history"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span>Lịch sử</span></button>
    </nav>
    <div class="cp-drawer-body"><div id="drawerLoading" class="cp-detail-loading"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i><span>Đang tải thông tin hợp đồng...</span></div><section id="drawerGeneral"></section><section id="drawerBooking" class="cp-hidden"></section><section id="drawerPayments" class="cp-hidden"></section><section id="drawerHistory" class="cp-hidden"></section></div>
    <footer class="cp-drawer-actions" id="drawerActions"></footer>
</aside>

<div class="cp-modal" id="createModal" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
    <div class="cp-modal-card cp-create-modal-card">
        <header class="cp-modal-head cp-create-modal-head">
            <div class="cp-create-title">
                <span class="cp-create-title-icon" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></span>
                <div>
                    <span class="cp-create-eyebrow">HỢP ĐỒNG MỚI</span>
                    <h2 id="createModalTitle">Tạo hợp đồng bản nháp</h2>
                    <p>Chọn booking đã xác nhận và hoàn thiện các thông tin cần thiết.</p>
                </div>
            </div>
            <button type="button" class="cp-drawer-close cp-create-close" data-close-modal="createModal" aria-label="Đóng cửa sổ tạo hợp đồng"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="cp-modal-body cp-create-modal-body">
            <div class="cp-create-alert cp-hidden" id="createFormError" role="alert"></div>
            <div class="cp-create-layout">
                <section class="cp-create-section cp-create-booking-section" aria-labelledby="createBookingHeading">
                    <header class="cp-create-section-head">
                        <span class="cp-create-step">1</span>
                        <div><h3 id="createBookingHeading">Chọn booking</h3><p>Chỉ hiển thị booking đã xác nhận và chưa có hợp đồng.</p></div>
                    </header>
                    <div class="cp-form-group cp-create-search">
                        <label for="eligibleKeyword">Tìm booking</label>
                        <div class="cp-create-search-control"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="cp-input" id="eligibleKeyword" autocomplete="off" placeholder="Mã booking, khách hàng hoặc SĐT" /></div>
                    </div>
                    <div class="cp-booking-picker" id="eligibleBookings"><div class="cp-empty">Đang tải booking đủ điều kiện...</div></div>
                    <div class="cp-booking-summary cp-hidden" id="selectedBookingSummary"></div>
                </section>
                <section class="cp-create-section cp-create-detail-section" aria-labelledby="createDetailHeading">
                    <header class="cp-create-section-head">
                        <span class="cp-create-step">2</span>
                        <div><h3 id="createDetailHeading">Thông tin hợp đồng</h3><p>Có thể chỉnh sửa các nội dung này trước khi kích hoạt.</p></div>
                    </header>
                    <div class="cp-create-form">
                        <div class="cp-form-group">
                            <label for="createTotalValue">Tổng giá trị <span class="cp-required" aria-hidden="true">*</span></label>
                            <div class="cp-money-input"><input class="cp-input" id="createTotalValue" type="number" min="1000" step="1000" inputmode="numeric" aria-describedby="createTotalValueHint" /><span>đ</span></div>
                            <small id="createTotalValueHint">Tự động lấy từ giá trị dự kiến của booking.</small>
                        </div>
                        <div class="cp-form-group">
                            <label for="createContent">Nội dung hợp đồng</label>
                            <textarea class="cp-textarea" id="createContent" rows="6" placeholder="Mô tả phạm vi dịch vụ, thông tin tiệc và các thỏa thuận..."></textarea>
                        </div>
                        <div class="cp-form-group">
                            <label for="createTerms">Điều khoản thanh toán</label>
                            <textarea class="cp-textarea" id="createTerms" rows="5" placeholder="Ví dụ: Đặt cọc 10%, thời hạn và phương thức thanh toán..."></textarea>
                        </div>
                    </div>
                </section>
            </div>
        </div>
        <footer class="cp-modal-actions cp-create-actions">
            <div class="cp-create-draft-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>Hợp đồng sẽ được lưu ở trạng thái <strong>Nháp</strong> và vẫn có thể chỉnh sửa.</span></div>
            <div class="cp-create-action-buttons"><button type="button" class="cp-secondary" data-close-modal="createModal">Hủy</button><button type="button" class="cp-primary" id="saveDraft"><i class="fa-regular fa-floppy-disk" aria-hidden="true"></i><span>Lưu bản nháp</span></button></div>
        </footer>
    </div>
</div>

<div class="cp-modal" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle"><div class="cp-modal-card"><header class="cp-modal-head"><h2 id="editModalTitle">Sửa hợp đồng bản nháp</h2><button type="button" class="cp-drawer-close" data-close-modal="editModal"><i class="fa-solid fa-xmark"></i></button></header><div class="cp-modal-body"><div class="cp-form-group"><label for="editTotalValue">Tổng giá trị (đ)</label><input class="cp-input" id="editTotalValue" type="number" min="0" step="1000" /></div><div class="cp-form-group"><label for="editContent">Nội dung hợp đồng</label><textarea class="cp-textarea" id="editContent"></textarea></div><div class="cp-form-group"><label for="editTerms">Điều khoản thanh toán</label><textarea class="cp-textarea" id="editTerms"></textarea></div></div><footer class="cp-modal-actions"><button type="button" class="cp-secondary" data-close-modal="editModal">Hủy</button><button type="button" class="cp-primary" id="saveEdit">Lưu thay đổi</button></footer></div></div>

<div class="cp-modal" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle"><div class="cp-modal-card small"><header class="cp-modal-head"><h2 id="confirmTitle">Xác nhận</h2><button type="button" class="cp-drawer-close" data-close-modal="confirmModal"><i class="fa-solid fa-xmark"></i></button></header><div class="cp-modal-body"><p id="confirmMessage" style="margin:0;font-size:12px;line-height:1.65;color:#42516a"></p></div><footer class="cp-modal-actions"><button type="button" class="cp-secondary" data-close-modal="confirmModal">Hủy</button><button type="button" class="cp-primary" id="confirmAction">Xác nhận</button></footer></div></div>


<div class="cp-modal" id="recordPaymentModal" role="dialog" aria-modal="true" aria-labelledby="recordPaymentTitle">
    <div class="cp-modal-card small">
        <header class="cp-modal-head">
            <h2 id="recordPaymentTitle">Thu tiền đợt 2 / Quyết toán</h2>
            <button type="button" class="cp-drawer-close" data-close-modal="recordPaymentModal"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <div class="cp-modal-body">
            <input type="hidden" id="recordPaymentContractId" />
            <div class="cp-form-group">
                <label for="recordPaymentType">Loại thanh toán</label>
                <select class="cp-select" id="recordPaymentType">
                    <option value="Thanh toán đợt">Thanh toán đợt (Đợt 2 - Trước tiệc)</option>
                    <option value="Quyết toán">Quyết toán hợp đồng (Sau tiệc)</option>
                </select>
            </div>
            <div class="cp-form-group">
                <label for="recordPaymentMethod">Hình thức thu tiền</label>
                <select class="cp-select" id="recordPaymentMethod">
                    <option value="CASH">Tiền mặt tại quầy (Ghi nhận ngay)</option>
                    <option value="VIETQR_PAYOS">Tạo mã QR VietQR PayOS</option>
                </select>
            </div>
            <div class="cp-form-group">
                <label for="recordPaymentAmount">Số tiền thanh toán (VNĐ)</label>
                <input class="cp-input" id="recordPaymentAmount" type="number" min="1000" step="1000" placeholder="Nhập số tiền..." />
                <div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;">
                    <button type="button" class="cp-secondary" style="min-height:28px;padding:2px 8px;font-size:11px;" id="btnFill50">50% Hợp đồng</button>
                    <button type="button" class="cp-secondary" style="min-height:28px;padding:2px 8px;font-size:11px;" id="btnFillRemaining">Còn lại</button>
                </div>
            </div>
            <div class="cp-form-group" id="groupPaymentNote">
                <label for="recordPaymentNote">Ghi chú (Tùy chọn)</label>
                <input class="cp-input" id="recordPaymentNote" placeholder="Ví dụ: Khách thanh toán tại quầy lễ tân..." />
            </div>
            <div id="paymentHelperMsg" style="font-size:11.5px;color:#64748B;line-height:1.5;"></div>
        </div>
        <footer class="cp-modal-actions">
            <button type="button" class="cp-secondary" data-close-modal="recordPaymentModal">Hủy</button>
            <button type="button" class="cp-primary" id="btnSubmitPayment"><i class="fa-solid fa-check"></i> Xác nhận</button>
        </footer>
    </div>
</div>

<div class="rp-pay-backdrop cp-modal" id="payosModal" role="dialog" aria-modal="true" aria-labelledby="payosModalTitle">
    <div class="rp-pay-modal" style="max-width:540px;">
        <!-- Header -->
        <div class="rp-pay-header">
            <div class="rp-pay-kicker">
                <i class="fa-solid fa-shield-halved"></i> Riverside Palace · Thanh toán an toàn VietQR PayOS
            </div>
            <h3 class="rp-pay-title" id="payosModalTitle">Thanh toán Hợp đồng & Quyết toán</h3>
            <button type="button" class="rp-pay-close" data-close-modal="payosModal" aria-label="Đóng popup">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="rp-pay-body">
            <!-- Initial State (Chờ thanh toán) -->
            <div id="payosInitialContent">
                <!-- Info Box -->
                <div class="rp-pay-info-box">
                    <div class="rp-pay-booking-code">
                        <span>Hợp đồng:</span>
                        <strong id="payosContractCodeDisplay">HD-...</strong>
                    </div>
                    <div class="rp-pay-deposit-amount">
                        <span id="payosTypeLabel">Khoản thanh toán:</span>
                        <h3 id="payosAmountDisplay">0 đ</h3>
                    </div>
                </div>

                <!-- Alert Demo Scale -->
                <div class="rp-pay-demo-banner" id="payosDemoBanner" style="display:none;">
                    <i class="fa-solid fa-lightbulb"></i>
                    <div>
                        <strong>Chế độ Thử nghiệm:</strong> Số tiền thanh toán qua VietQR đã được quy đổi thành <strong id="payosActualAmountDisplay" style="color:#DC2626;font-size:13.5px;">2.000 VNĐ</strong> (tỷ lệ 1/10.000) để khách hàng có thể quét chuyển tiền thật bằng App ngân hàng trải nghiệm trọn vẹn quy trình.
                    </div>
                </div>

                <!-- QR Card -->
                <div class="rp-pay-qr-card">
                    <div class="rp-pay-qr-wrapper">
                        <!-- Loading State -->
                        <div id="payosQrLoading" class="rp-pay-qr-loading">
                            <div class="rp-pay-spinner"></div>
                            <span id="payosQrLoadingText">Đang khởi tạo mã VietQR từ PayOS...</span>
                        </div>

                        <!-- Error State -->
                        <div id="payosQrError" class="rp-pay-qr-error" style="display:none;">
                            <i class="fa-solid fa-triangle-exclamation" style="font-size:30px;color:#EF4444;margin-bottom:8px;"></i>
                            <p id="payosQrErrorMsg" style="font-size:12.5px;color:#991B1B;margin:0 0 12px;line-height:1.4;">
                                Không thể tải mã QR thanh toán. Vui lòng bấm thử lại hoặc liên hệ quản trị viên.
                            </p>
                        </div>

                        <!-- QR Image -->
                        <img id="payosQrImg" class="rp-pay-qr-img" alt="Mã VietQR Thanh toán" style="display:none;" />
                    </div>

                    <div>
                        <div class="rp-pay-timer-pill">
                            <span class="dot"></span>
                            Thời gian chờ thanh toán: <span id="payosCountdownVal">10:00</span>
                        </div>
                    </div>
                </div>

                <!-- Transfer Details -->
                <div class="rp-pay-details">
                    <div class="rp-pay-detail-row">
                        <span class="rp-pay-detail-label">Ngân hàng thụ hưởng:</span>
                        <span class="rp-pay-detail-val" id="payosBankName">MB Bank</span>
                    </div>
                    <div class="rp-pay-detail-row">
                        <span class="rp-pay-detail-label">Chủ tài khoản:</span>
                        <span class="rp-pay-detail-val" id="payosAccountName">CONG TY CP RIVERSIDE PALACE</span>
                    </div>
                    <div class="rp-pay-detail-row">
                        <span class="rp-pay-detail-label">Số tài khoản:</span>
                        <div class="rp-pay-detail-val">
                            <span id="payosAccountNo" style="font-family:monospace;letter-spacing:0.05em;">--</span>
                            <button type="button" class="rp-pay-copy-btn" id="payosCopyAccBtn"><i class="fa-regular fa-copy"></i> Chép</button>
                        </div>
                    </div>
                    <div class="rp-pay-detail-row">
                        <span class="rp-pay-detail-label">Nội dung chuyển khoản:</span>
                        <div class="rp-pay-detail-val">
                            <span id="payosTransferDesc" style="color:#DC2626;font-family:monospace;font-weight:800;">RSP --</span>
                            <button type="button" class="rp-pay-copy-btn" id="payosCopyDescBtn"><i class="fa-regular fa-copy"></i> Chép</button>
                        </div>
                    </div>
                    <div class="rp-pay-detail-row">
                        <span class="rp-pay-detail-label">Mã giao dịch PayOS:</span>
                        <span class="rp-pay-detail-val" id="payosOrderCode" style="font-family:monospace;">--</span>
                    </div>
                </div>

                <!-- Polling Status -->
                <div class="rp-pay-status-bar" id="payosStatusAlert">
                    <div class="rp-pay-spinner"></div>
                    <span id="payosStatusText">Đang chờ hệ thống ngân hàng xác nhận giao dịch...</span>
                </div>
            </div>

            <!-- Success State (Thanh toán thành công) -->
            <div id="payosSuccessContent" class="rp-pay-success-box" style="display:none;">
                <div class="rp-pay-success-icon">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h3 class="rp-pay-success-title">Thanh Toán PayOS Thành Công!</h3>
                <p class="rp-pay-success-desc">
                    Hệ thống đã nhận thanh toán <strong id="payosSuccessAmount">0 đ</strong> qua VietQR PayOS. Hợp đồng và lịch sử giao dịch đã được cập nhật tự động.
                </p>
                <div style="font-size:12.5px;color:#10B981;font-weight:700;margin-bottom:18px;">
                    <i class="fa-solid fa-circle-check"></i> Giao dịch hợp lệ và được lưu trữ trong sổ kế toán điện tử.
                </div>
                <button type="button" class="rp-pay-btn-done" data-close-modal="payosModal">
                    <i class="fa-solid fa-check"></i> Hoàn tất & Quay lại hợp đồng
                </button>
            </div>
        </div>
        <footer class="cp-modal-actions" style="justify-content:space-between;border-top:1px solid #E2E8F0;padding:12px 20px;">
            <button type="button" class="cp-secondary" id="btnCopyPayosLink"><i class="fa-regular fa-copy"></i> Sao chép link</button>
            <div style="display:flex;gap:8px;">
                <button type="button" class="cp-secondary" data-close-modal="payosModal">Đóng</button>
                <button type="button" class="cp-primary" id="btnCheckPayosNow"><i class="fa-solid fa-arrows-rotate"></i> Kiểm tra ngay</button>
            </div>
        </footer>
    </div>
</div>

@section Scripts { <script src="~/js/manager-contract-payment.js" asp-append-version="true"></script> }
