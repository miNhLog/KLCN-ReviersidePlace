@model HeThongDatTiecCuoi_WEB.Models.Coordination.CoordinatorAssignedPartyViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = $"Chi tiết {Model.BookingCode}"; }
@section Styles { <link rel="stylesheet" href="~/css/coordination.css" asp-append-version="true" /> }
<header class="top-header"><div><div class="breadcrumb">Quản trị hệ thống <span>›</span> Tiệc được phân công <span>›</span> <strong>@Model.BookingCode</strong></div><h2>Chi tiết tiệc</h2></div></header>
<section class="content coordinator-detail-page">
    <div class="assignment-hero"><div><span class="eyebrow">ĐIỀU PHỐI TIỆC</span><h1>@Model.BookingCode — @Model.CustomerName</h1><p>@Model.HallName · @Model.EventDate.ToString("dd/MM/yyyy") · @Model.Shift</p></div><div class="coordinator-action-buttons"><a class="coord-btn secondary" asp-action="AssignedParties">Quay lại</a><a class="coord-btn primary" asp-controller="CoordinatorIncident" asp-action="Index" asp-route-bookingId="@Model.BookingId">Báo cáo sự cố</a></div></div>
    <div class="coordinator-detail-grid">
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-circle-info"></i> Thông tin chung</h3><dl><dt>Khách hàng</dt><dd>@Model.CustomerName</dd><dt>Ngày / ca</dt><dd>@Model.EventDate.ToString("dd/MM/yyyy") · @Model.Shift</dd><dt>Sảnh</dt><dd>@Model.HallName</dd><dt>Số bàn</dt><dd>@Model.TableCount</dd><dt>Trạng thái</dt><dd>@Model.BookingStatusName</dd></dl></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-utensils"></i> Thực đơn</h3><p>@(Model.MenuName ?? "Chưa chọn thực đơn")</p></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-wand-magic-sparkles"></i> Trang trí &amp; dịch vụ</h3><dl><dt>Gói trang trí</dt><dd>@(Model.DecorationName ?? "Chưa chọn")</dd><dt>Dịch vụ</dt><dd>@(Model.Services.Count == 0 ? "Không có" : string.Join(", ", Model.Services))</dd></dl></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-note-sticky"></i> Yêu cầu đặc biệt</h3><p>@(Model.SpecialRequests ?? "Không có yêu cầu đặc biệt")</p></article>
    </div>
</section>
