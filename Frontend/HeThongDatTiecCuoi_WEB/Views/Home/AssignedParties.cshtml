@model List<HeThongDatTiecCuoi_WEB.Models.Coordination.CoordinatorAssignedPartyViewModel>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tiệc được phân công"; }
@section Styles { <link rel="stylesheet" href="~/css/coordination.css" asp-append-version="true" /> }
<header class="top-header"><div><div class="breadcrumb">Quản trị hệ thống <span>›</span> <strong>Tiệc được phân công</strong></div><h2>Tiệc được phân công</h2></div></header>
<section class="content coordinator-page">
    @if (ViewData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error)) { <div class="coord-alert error">@error</div> }
    <div class="assignment-hero"><div><span class="eyebrow">ĐIỀU PHỐI TIỆC</span><h1>Danh sách tiệc của tôi</h1><p>Chỉ hiển thị phân công đang hiệu lực của tài khoản đang đăng nhập.</p></div></div>
    <div class="hall-schedule-table-wrap"><table class="hall-schedule-table assigned-party-table"><thead><tr><th>Mã tiệc</th><th>Khách hàng</th><th>Ngày</th><th>Ca</th><th>Sảnh</th><th>Số bàn</th><th>Thực đơn</th><th>Trang trí</th><th>Dịch vụ</th><th>Yêu cầu đặc biệt</th><th>Trạng thái</th></tr></thead><tbody>
    @if (Model.Count == 0) { <tr><td colspan="11" class="table-empty-state">Hiện chưa có tiệc nào được phân công cho bạn.</td></tr> }
    @foreach (var item in Model) { <tr><td><a asp-action="AssignedPartyDetail" asp-route-bookingId="@item.BookingId"><strong>@item.BookingCode</strong></a></td><td>@item.CustomerName</td><td>@item.EventDate.ToString("dd/MM/yyyy")</td><td>@item.Shift</td><td>@item.HallName</td><td>@item.TableCount</td><td>@(item.MenuName ?? "—")</td><td>@(item.DecorationName ?? "—")</td><td>@(item.Services.Count == 0 ? "—" : string.Join(", ", item.Services))</td><td>@(item.SpecialRequests ?? "—")</td><td><span class="coord-state assigned">@item.BookingStatusName</span></td></tr> }
    </tbody></table></div>
</section>
