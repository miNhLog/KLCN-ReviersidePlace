        // Modal Đổi đơn giá sảnh
        function openQuickPriceModal(id, name, currentPrice) {
            document.getElementById('quickPriceHallId').value = id;
            document.getElementById('quickPriceTitle').innerText = `Đổi đơn giá sảnh ${name}`;
            document.getElementById('quickPriceInput').value = currentPrice;
            document.getElementById('quickPriceModal').classList.remove('hidden');
        }

        function closeQuickPriceModal() {
            document.getElementById('quickPriceModal').classList.add('hidden');
        }

        async function saveQuickPrice() {
            const id = parseInt(document.getElementById('quickPriceHallId').value);
            const newPrice = parseFloat(document.getElementById('quickPriceInput').value);

            if (!newPrice || newPrice < 1000000) {
                showToast('Đơn giá thuê sảnh phải từ 1.000.000 VNĐ', false);
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('hallId', id);
            formData.append('newPrice', newPrice);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/AdminPricingPolicy/UpdateHallPrice', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();

                if (result.success) {
                    const target = hallPricingData.find(x => x.sanhTiecId === id);
                    if (target) {
                        target.giaGoc = newPrice;
                        target.giaCaTrua = newPrice;
                        target.giaCaToi = newPrice * 1.15;
                        target.giaCuoiTuan = newPrice * 1.25;
                    }
                    closeQuickPriceModal();
                    applyPolicyFilters();
                    showToast(result.message || 'Cập nhật giá sảnh thành công!');
                } else {
                    showToast(result.message || 'Lỗi cập nhật giá sảnh', false);
                }
            } catch (err) {
                console.error(err);
                showToast('Không thể kết nối máy chủ để lưu giá.', false);
            }
        }

        // Xử lý Modal Thêm/Cập nhật Chính sách
        function openPolicyModal() {
            document.getElementById('policyForm').reset();
            document.getElementById('form-policy-id').value = '0';
            document.getElementById('modal-policy-title').innerText = 'Thêm chính sách thanh toán mới';
            document.getElementById('form-policy-code').value = 'POL-PAY-0' + (paymentPolicies.length + 1);
            document.getElementById('form-policy-type').value = 'Đặt cọc & Giữ chỗ';
            document.getElementById('form-policy-val').value = '20% Tổng dự toán';
            document.getElementById('form-policy-time').value = 'Trong 48 giờ';
            document.getElementById('policyModal').classList.remove('hidden');
        }

        function editPolicyItem(id) {
            const item = paymentPolicies.find(x => x.id === id);
            if (!item) return;

            document.getElementById('form-policy-id').value = item.id;
            document.getElementById('modal-policy-title').innerText = 'Cập nhật chính sách thanh toán';
            document.getElementById('form-policy-code').value = item.ma;
            document.getElementById('form-policy-name').value = item.ten;
            document.getElementById('form-policy-type').value = item.phanLoai;
            document.getElementById('form-policy-val').value = item.dinhMuc;
            document.getElementById('form-policy-time').value = item.thoiHan;
            document.getElementById('form-policy-desc').value = item.moTa;
            document.getElementById('form-policy-status').value = item.trangThai;

            document.getElementById('policyModal').classList.remove('hidden');
        }

        function closePolicyModal() {
            document.getElementById('policyModal').classList.add('hidden');
        }

        function handlePolicyFormSubmit(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('form-policy-id').value);

            const record = {
                id: id === 0 ? Date.now() : id,
                ma: document.getElementById('form-policy-code').value.trim(),
                ten: document.getElementById('form-policy-name').value.trim(),
                phanLoai: document.getElementById('form-policy-type').value.trim(),
                dinhMuc: document.getElementById('form-policy-val').value.trim(),
                thoiHan: document.getElementById('form-policy-time').value.trim(),
                moTa: document.getElementById('form-policy-desc').value.trim(),
                canCu: 'Quy chuẩn hợp đồng 2026',
                trangThai: document.getElementById('form-policy-status').value
            };

            if (id === 0) {
                paymentPolicies.unshift(record);
                showToast('Đã thêm điều khoản chính sách mới thành công!');
            } else {
                const index = paymentPolicies.findIndex(x => x.id === id);
                if (index !== -1) paymentPolicies[index] = record;
                showToast('Đã lưu các thay đổi của điều khoản!');
            }

            closePolicyModal();
            populatePolicyCatFilter();
            applyPolicyFilters();
        }

        // Đổi trạng thái Khóa/Mở
        function togglePolicyStatus(id) {
            const item = paymentPolicies.find(x => x.id === id);
            if (item) {
                item.trangThai = item.trangThai === 'Hiệu lực' ? 'Tạm ngưng' : 'Hiệu lực';
                applyPolicyFilters();
                showToast(`Đã chuyển trạng thái ${item.ma} sang: ${item.trangThai}`);
            }
        }

        function toggleNotificationDropdown() {
            document.getElementById('notification-dropdown').classList.toggle('hidden');
        }

        function markAllNotificationsRead() {
            const badge = document.getElementById('notif-badge');
            if (badge) badge.classList.add('hidden');
            showToast('Tất cả thông báo đã được đánh dấu là Đã đọc.');
        }

        // 13. XỬ LÝ XUẤT EXCEL THỰC TẾ BẰNG SHEETJS
        function exportPolicyExcel() {
            let dataToExport = [];
            let fileName = '';
            let sheetName = '';

            if (currentPolicyTab === 'payment') {
                fileName = 'Riverside_ChinhSach_ThanhToan.xlsx';
                sheetName = 'Chinh_Sach_Thanh_Toan';
                dataToExport = paymentPolicies.map((item, index) => ({
                    'STT': index + 1,
                    'Mã Quy Định': item.ma,
                    'Tên Điều Khoản': item.ten,
                    'Phân Loại': item.phanLoai,
                    'Định Mức / Tỷ Lệ': item.dinhMuc,
                    'Thời Hạn / Mốc': item.thoiHan,
                    'Căn Cứ Nghiệp Vụ': item.canCu,
                    'Mô Tả Chi Tiết': item.moTa,
                    'Trạng Thái': item.trangThai
                }));
                var wscols = [{wch:5}, {wch:15}, {wch:35}, {wch:25}, {wch:20}, {wch:20}, {wch:30}, {wch:60}, {wch:15}];
            } else {
                fileName = 'Riverside_BangGia_SanhTiec.xlsx';
                sheetName = 'Bang_Gia_Sanh';
                dataToExport = hallPricingData.map((item, index) => ({
                    'STT': index + 1,
                    'Mã Sảnh': item.maSanh,
                    'Tên Đại Sảnh': item.tenSanh,
                    'Sức Chứa Tối Thiểu': item.sucChuaToiThieu,
                    'Sức Chứa Tối Đa': item.sucChuaToiDa,
                    'Giá Cơ Sở (VNĐ)': item.giaGoc,
                    'Giá Ca Trưa (VNĐ)': item.giaCaTrua,
                    'Giá Ca Tối (+15%)': item.giaCaToi,
                    'Giá Cuối Tuần (+25%)': item.giaCuoiTuan,
                    'Trạng Thái': item.trangThai
                }));
                var wscols = [{wch:5}, {wch:15}, {wch:25}, {wch:20}, {wch:20}, {wch:20}, {wch:20}, {wch:20}, {wch:20}, {wch:15}];
            }

            const ws = XLSX.utils.json_to_sheet(dataToExport);
            ws['!cols'] = wscols;
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, sheetName);

            XLSX.writeFile(wb, fileName);
            showToast('Đã xuất biểu mẫu Excel thành công!');
        }
    </script>
}