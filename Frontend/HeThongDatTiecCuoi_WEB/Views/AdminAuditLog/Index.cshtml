@using System.Text.Json
@model HeThongDatTiecCuoi_WEB.Models.AdminAccount.AuditLogPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhật ký hệ thống";

    var categories = new[]
    {
        new { Key = "", Label = "Tổng quan / Tất cả nhật ký", ShortLabel = "Tất cả nhật ký", Icon = "fa-layer-group", Description = "Toàn bộ hoạt động hệ thống mà quản trị viên được phép truy vết." },
        new { Key = "authentication", Label = "Xác thực & bảo mật", ShortLabel = "Xác thực & bảo mật", Icon = "fa-shield-halved", Description = "Đăng nhập, đăng xuất, đổi mật khẩu và các sự kiện bảo mật." },
        new { Key = "account", Label = "Tài khoản & phân quyền", ShortLabel = "Tài khoản & phân quyền", Icon = "fa-user-gear", Description = "Tạo, cập nhật, khóa tài khoản và thay đổi quyền truy cập." },
        new { Key = "booking", Label = "Đặt tiệc", ShortLabel = "Đặt tiệc", Icon = "fa-calendar-check", Description = "Các thay đổi liên quan đến yêu cầu và trạng thái đặt tiệc." },
        new { Key = "contract", Label = "Hợp đồng", ShortLabel = "Hợp đồng", Icon = "fa-file-signature", Description = "Quá trình tạo, cập nhật, kích hoạt và hoàn tất hợp đồng." },
        new { Key = "payment", Label = "Thanh toán & hoàn tiền", ShortLabel = "Thanh toán & hoàn tiền", Icon = "fa-money-check-dollar", Description = "Thu tiền, PayOS, đối soát và xác nhận hoàn tiền." },
        new { Key = "schedule", Label = "Lịch sảnh & đổi lịch", ShortLabel = "Lịch sảnh & đổi lịch", Icon = "fa-calendar-days", Description = "Lịch sảnh, yêu cầu đổi lịch và các bước xử lý liên quan." },
        new { Key = "catalog", Label = "Danh mục & chính sách giá", ShortLabel = "Danh mục & giá", Icon = "fa-tags", Description = "Sảnh, giá, thực đơn, món ăn, trang trí và dịch vụ." },
        new { Key = "workforce", Label = "Nhân sự & điều phối", ShortLabel = "Nhân sự & điều phối", Icon = "fa-people-group", Description = "Phân công quản lý sảnh, nhân viên và điều phối sự kiện." },
        new { Key = "incident", Label = "Sự cố", ShortLabel = "Sự cố", Icon = "fa-triangle-exclamation", Description = "Ghi nhận, cập nhật trạng thái và hướng xử lý sự cố." }
    };

    var selectedGroup = categories.Any(item => item.Key == (Model.Group ?? "")) ? Model.Group ?? "" : "";
    var currentCategory = categories.First(item => item.Key == selectedGroup);
    var actions = new Dictionary<string, (string Label, string Group)>
    {
        ["LOGIN_SUCCESS"] = ("Đăng nhập thành công", "authentication"), ["LOGIN_FAILED"] = ("Đăng nhập thất bại", "authentication"),
        ["LOGIN_BLOCKED"] = ("Đăng nhập bị từ chối", "authentication"), ["LOGOUT"] = ("Đăng xuất", "authentication"),
        ["PASSWORD_CHANGED"] = ("Đổi mật khẩu", "authentication"), ["PASSWORD_RESET_COMPLETED"] = ("Hoàn tất đặt lại mật khẩu", "authentication"),
        ["FIRST_PASSWORD_CHANGED"] = ("Hoàn tất đổi mật khẩu lần đầu", "authentication"), ["ADMIN_PASSWORD_CHANGED"] = ("Đổi mật khẩu quản trị viên", "authentication"),
        ["CREATE_ACCOUNT"] = ("Cấp tài khoản", "account"), ["UPDATE_ACCOUNT"] = ("Cập nhật tài khoản", "account"),
        ["LOCK_ACCOUNT"] = ("Khóa tài khoản", "account"), ["UNLOCK_ACCOUNT"] = ("Mở khóa tài khoản", "account"),
        ["CHANGE_ROLE"] = ("Thay đổi vai trò", "account"), ["RESET_PASSWORD"] = ("Đặt lại mật khẩu", "account"),
        ["ROLE_CHANGE_REQUESTED"] = ("Gửi yêu cầu thay đổi vai trò", "account"), ["ROLE_CHANGE_APPROVED"] = ("Duyệt thay đổi vai trò", "account"),
        ["ROLE_CHANGE_REJECTED"] = ("Từ chối thay đổi vai trò", "account"),
        ["BOOKING_CREATED"] = ("Tạo đặt tiệc", "booking"), ["BOOKING_STATUS_CHANGED"] = ("Đổi trạng thái đặt tiệc", "booking"),
        ["BOOKING_CANCELLED"] = ("Hủy đặt tiệc", "booking"), ["BOOKING_HOLD_CANCELLED"] = ("Khách hủy giữ chỗ", "booking"), ["CANCEL"] = ("Khách hủy giữ chỗ (cũ)", "booking"),
        ["CONTRACT_CREATED"] = ("Tạo hợp đồng", "contract"), ["CONTRACT_UPDATED"] = ("Cập nhật hợp đồng", "contract"),
        ["CONTRACT_ACTIVATED"] = ("Kích hoạt hợp đồng", "contract"), ["CONTRACT_COMPLETED"] = ("Hoàn tất hợp đồng", "contract"), ["CONTRACT_CANCELLED"] = ("Hủy hợp đồng", "contract"),
        ["PAYMENT"] = ("Thanh toán PayOS", "payment"), ["PAYMENT_RECORDED"] = ("Ghi nhận thu tiền", "payment"), ["SCHEDULE_CHANGE_REFUND_CONFIRMED"] = ("Xác nhận hoàn tiền", "payment"),
        ["SCHEDULE_CHANGE_CREATED"] = ("Tạo yêu cầu đổi lịch", "schedule"), ["SCHEDULE_CHANGE_REVIEW"] = ("Duyệt yêu cầu đổi lịch", "schedule"),
        ["SCHEDULE_CHANGE_QUOTED"] = ("Báo giá đổi lịch", "schedule"), ["SCHEDULE_CHANGE_REJECTED"] = ("Từ chối đổi lịch", "schedule"),
        ["SCHEDULE_CHANGE_WITHDRAWN"] = ("Rút yêu cầu đổi lịch", "schedule"), ["SCHEDULE_CHANGE_RECONCILED"] = ("Đối soát đổi lịch", "schedule"),
        ["SCHEDULE_CHANGE_APPLIED"] = ("Áp dụng đổi lịch", "schedule"), ["HALL_SCHEDULE_STATUS_CHANGED"] = ("Đổi trạng thái lịch sảnh", "schedule"),
        ["HALL_PRICE_UPDATED"] = ("Cập nhật giá sảnh", "catalog"), ["HALL_CREATED"] = ("Tạo sảnh", "catalog"), ["HALL_UPDATED"] = ("Cập nhật sảnh", "catalog"),
        ["MENU_CREATED"] = ("Tạo thực đơn", "catalog"), ["MENU_UPDATED"] = ("Cập nhật thực đơn", "catalog"), ["MENU_DISHES_CHANGED"] = ("Thay đổi món trong thực đơn", "catalog"),
        ["DISH_CREATED"] = ("Tạo món ăn", "catalog"), ["DISH_UPDATED"] = ("Cập nhật món ăn", "catalog"), ["DECOR_CREATED"] = ("Tạo gói trang trí", "catalog"),
        ["DECOR_UPDATED"] = ("Cập nhật gói trang trí", "catalog"), ["SERVICE_CREATED"] = ("Tạo dịch vụ", "catalog"), ["SERVICE_UPDATED"] = ("Cập nhật dịch vụ", "catalog"),
        ["HALL_MANAGER_ASSIGNED"] = ("Phân công quản lý sảnh", "workforce"), ["HALL_MANAGER_ASSIGNMENT_ENDED"] = ("Kết thúc quản lý sảnh", "workforce"),
        ["COORDINATION_ASSIGNED"] = ("Phân công điều phối", "workforce"), ["COORDINATION_CHANGED"] = ("Đổi phân công điều phối", "workforce"),
        ["COORDINATION_CANCELLED"] = ("Hủy phân công điều phối", "workforce"), ["COORDINATION_COMPLETED"] = ("Hoàn tất điều phối", "workforce"),
        ["INCIDENT_CREATED"] = ("Tạo sự cố", "incident"), ["INCIDENT_UPDATED"] = ("Cập nhật sự cố", "incident"),
        ["INCIDENT_STATUS_CHANGED"] = ("Đổi trạng thái sự cố", "incident"), ["INCIDENT_RESOLUTION_UPDATED"] = ("Cập nhật hướng xử lý", "incident")
    };
    string ActionLabel(string action) => actions.TryGetValue(action, out var value) ? value.Label : action;
    var availableActions = selectedGroup.Length == 0 ? actions : actions.Where(item => item.Value.Group == selectedGroup).ToDictionary(item => item.Key, item => item.Value);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.Action) || !string.IsNullOrWhiteSpace(Model.Outcome)
        || !string.IsNullOrWhiteSpace(Model.AuthMethod) || Model.FromDate.HasValue || Model.ToDate.HasValue;
    var firstItem = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
    var activeFilterCount = new object?[] { Model.Keyword, Model.Action, Model.Outcome, Model.AuthMethod, Model.FromDate, Model.ToDate }.Count(value => value is not null && !string.IsNullOrWhiteSpace(value.ToString()));
    var periodLabel = Model.FromDate.HasValue || Model.ToDate.HasValue
        ? string.Join(" – ", Model.FromDate?.ToString("dd/MM/yyyy") ?? "Bắt đầu", Model.ToDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")
        : "Tất cả thời gian";
}

<link rel="stylesheet" href="~/css/admin-audit-log.css" asp-append-version="true" />

<section class="audit-page">
    <header class="audit-page-header">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> QUẢN TRỊ HỆ THỐNG</span>
            <h1>Nhật ký hệ thống</h1>
            <p>Tra cứu hoạt động, kiểm soát truy cập và truy vết thay đổi trong hệ thống.</p>
        </div>
        <div class="audit-header-status"><span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span><div><small>Phạm vi truy cập</small><strong>Quản trị viên</strong></div></div>
    </header>

    <section class="audit-overview" aria-label="Tổng quan nhật ký">
        <article><span class="audit-overview-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span><div><small>Tổng kết quả</small><strong>@Model.TotalItems.ToString("N0")</strong><em>Theo bộ lọc hiện tại</em></div></article>
        <article><span class="audit-overview-icon"><i class="fa-solid @currentCategory.Icon" aria-hidden="true"></i></span><div><small>Danh mục đang xem</small><strong>@currentCategory.ShortLabel</strong><em>Nhóm sự kiện nghiệp vụ</em></div></article>
        <article><span class="audit-overview-icon"><i class="fa-regular fa-calendar" aria-hidden="true"></i></span><div><small>Khoảng thời gian</small><strong>@periodLabel</strong><em>@(activeFilterCount > 0 ? $"{activeFilterCount} điều kiện đang áp dụng" : "Chưa giới hạn điều kiện")</em></div></article>
    </section>

    <details class="audit-mobile-navigation">
        <summary><span><i class="fa-solid @currentCategory.Icon" aria-hidden="true"></i><span><small>Danh mục nhật ký</small><strong>@currentCategory.ShortLabel</strong></span></span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
        <nav aria-label="Danh mục nhật ký trên điện thoại">
            @foreach (var category in categories)
            {
                <a class="@(category.Key == selectedGroup ? "active" : null)" aria-current="@(category.Key == selectedGroup ? "page" : null)" asp-action="Index" asp-route-group="@category.Key" asp-route-keyword="@Model.Keyword" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageSize="@Model.PageSize"><i class="fa-solid @category.Icon" aria-hidden="true"></i><span>@category.Label</span>@if (category.Key == selectedGroup){<i class="fa-solid fa-check audit-nav-check" aria-hidden="true"></i>}</a>
            }
        </nav>
    </details>

    <div class="audit-workspace">
        <aside class="audit-category-sidebar" aria-labelledby="auditCategoryTitle">
            <div class="audit-sidebar-heading"><span>Điều hướng</span><h2 id="auditCategoryTitle">Danh mục nhật ký</h2></div>
            <nav aria-label="Danh mục nhật ký">
                @foreach (var category in categories)
                {
                    <a class="audit-category-link @(category.Key == selectedGroup ? "active" : null)" aria-current="@(category.Key == selectedGroup ? "page" : null)" asp-action="Index" asp-route-group="@category.Key" asp-route-keyword="@Model.Keyword" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageSize="@Model.PageSize"><i class="fa-solid @category.Icon" aria-hidden="true"></i><span>@category.Label</span><i class="fa-solid @(category.Key == selectedGroup ? "fa-check" : "fa-chevron-right") audit-nav-state" aria-hidden="true"></i></a>
                }
            </nav>
        </aside>

        <main class="audit-content-panel">
            <header class="audit-section-header">
                <div><span class="audit-section-icon"><i class="fa-solid @currentCategory.Icon" aria-hidden="true"></i></span><div><p>Danh mục đang xem</p><h2>@currentCategory.ShortLabel</h2><span>@currentCategory.Description</span></div></div>
                <span class="audit-count"><strong>@Model.TotalItems</strong> kết quả</span>
            </header>

            <form method="get" class="audit-toolbar" id="auditFilterForm">
                <input type="hidden" name="group" value="@selectedGroup" />
                <div class="audit-filter-heading"><div><span><i class="fa-solid fa-sliders" aria-hidden="true"></i></span><div><h3>Bộ lọc tra cứu</h3><p>Thu hẹp danh sách theo nội dung, thao tác, kết quả hoặc thời gian.</p></div></div>@if (activeFilterCount > 0){<span class="audit-filter-count">@activeFilterCount bộ lọc</span>}</div>
                <label class="audit-field audit-search"><span>Tìm kiếm</span><span class="audit-input-wrap"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" name="keyword" value="@Model.Keyword" maxlength="200" placeholder="Người thực hiện, tài khoản, nội dung..." /></span></label>
                <label class="audit-field"><span>Thao tác</span><select name="auditAction"><option value="">Tất cả thao tác</option>@foreach (var item in availableActions){<option value="@item.Key" selected="@(Model.Action == item.Key)">@item.Value.Label</option>}</select></label>
                <label class="audit-field"><span>Kết quả</span><select name="outcome"><option value="">Tất cả kết quả</option><option value="SUCCESS" selected="@(Model.Outcome == "SUCCESS")">Thành công</option><option value="FAILED" selected="@(Model.Outcome == "FAILED")">Thất bại</option><option value="BLOCKED" selected="@(Model.Outcome == "BLOCKED")">Bị từ chối</option></select></label>
                @if (selectedGroup == "authentication")
                {
                    <label class="audit-field"><span>Phương thức xác thực</span><select name="authMethod"><option value="">Tất cả phương thức</option><option value="PASSWORD" selected="@(Model.AuthMethod == "PASSWORD")">Mật khẩu</option><option value="GOOGLE" selected="@(Model.AuthMethod == "GOOGLE")">Google</option><option value="JWT" selected="@(Model.AuthMethod == "JWT")">Phiên đăng nhập</option><option value="RESET_TOKEN" selected="@(Model.AuthMethod == "RESET_TOKEN")">Mã đặt lại mật khẩu</option></select></label>
                }
                <label class="audit-field"><span>Từ ngày</span><input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" /></label>
                <label class="audit-field"><span>Đến ngày</span><input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" /></label>
                <label class="audit-field"><span>Hiển thị</span><select name="pageSize"><option value="10" selected="@(Model.PageSize == 10)">10 dòng</option><option value="20" selected="@(Model.PageSize == 20)">20 dòng</option><option value="50" selected="@(Model.PageSize == 50)">50 dòng</option></select></label>
                <div class="audit-toolbar-actions"><button type="submit" class="audit-filter-button"><i class="fa-solid fa-filter" aria-hidden="true"></i>Lọc</button>@if (hasFilters){<a class="audit-reset-button" asp-action="Index" asp-route-group="@selectedGroup" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>Đặt lại</a>}</div>
                <p class="audit-filter-error" id="auditFilterError" role="alert" hidden></p>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="audit-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }

            <section class="audit-card" aria-labelledby="auditTableTitle">
                <div class="audit-card-heading"><div class="audit-card-title"><span><i class="fa-solid fa-table-list" aria-hidden="true"></i></span><div><h3 id="auditTableTitle">Lịch sử thao tác</h3><small>@Model.TotalItems nhật ký được tìm thấy</small></div></div>@if (Model.TotalItems > 0){<span>Hiển thị <strong>@firstItem–@lastItem</strong> / @Model.TotalItems</span>}</div>
                @if (Model.Items.Count == 0)
                {
                    <div class="audit-empty"><span class="audit-empty-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span><strong>@(hasFilters ? "Không tìm thấy nhật ký phù hợp" : $"Chưa có nhật ký {currentCategory.ShortLabel.ToLowerInvariant()}")</strong><span>@(hasFilters ? "Hãy thay đổi điều kiện lọc để xem kết quả khác." : "Các hoạt động thuộc danh mục này sẽ xuất hiện tại đây khi được hệ thống ghi nhận.")</span></div>
                }
                else
                {
                    <div class="audit-table-wrap"><table class="audit-table"><thead><tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện / nguồn</th><th scope="col">Hành động</th><th scope="col">Đối tượng</th><th scope="col">Kết quả</th><th scope="col"><span class="sr-only">Xem chi tiết</span></th></tr></thead><tbody>
                    @foreach (var log in Model.Items)
                    {
                        var detailId = $"audit-data-{log.AuditLogId}";
                        var outcomeLabel = log.Outcome == "SUCCESS" ? "Thành công" : log.Outcome == "FAILED" ? "Thất bại" : log.Outcome == "BLOCKED" ? "Bị từ chối" : "—";
                        <tr>
                            <td data-label="Thời gian" class="audit-time"><strong>@log.Timestamp.ToString("dd/MM/yyyy")</strong><small>@log.Timestamp.ToString("HH:mm:ss")</small></td>
                            <td data-label="Người thực hiện / nguồn" class="audit-actor"><span class="audit-avatar"><i class="fa-regular @(log.Source == "Internal" ? "fa-user" : "fa-circle-nodes")" aria-hidden="true"></i></span><span><strong>@log.ActorName</strong><small>@(string.IsNullOrWhiteSpace(log.ActorEmail) ? log.Source : log.ActorEmail)</small></span></td>
                            <td data-label="Hành động"><span class="audit-action">@ActionLabel(log.Action)</span></td>
                            <td data-label="Đối tượng" class="audit-target"><strong>@(string.IsNullOrWhiteSpace(log.Target) ? "—" : log.Target)</strong><small>@(string.IsNullOrWhiteSpace(log.EntityName) ? null : $"{log.EntityName} #{log.EntityId}")</small></td>
                            <td data-label="Kết quả"><span class="audit-outcome outcome-@((log.Outcome ?? "unknown").ToLowerInvariant())">@outcomeLabel</span></td>
                            <td data-label="Chi tiết" class="audit-detail"><button type="button" class="audit-detail-button" data-detail-id="@detailId" data-title="@ActionLabel(log.Action)" data-group-label="@categories.FirstOrDefault(item => item.Key == log.Group)?.ShortLabel"><span>Xem chi tiết</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button><script type="application/json" id="@detailId">@Html.Raw(JsonSerializer.Serialize(log))</script></td>
                        </tr>
                    }
                    </tbody></table></div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="audit-pagination" aria-label="Phân trang nhật ký">
                        <a class="audit-page-link @(Model.Page <= 1 ? "disabled" : null)" aria-label="Trang trước" aria-disabled="@(Model.Page <= 1 ? "true" : null)" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword" asp-route-group="@selectedGroup" asp-route-outcome="@Model.Outcome" asp-route-authMethod="@Model.AuthMethod"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                        @for (var number = Math.Max(1, Model.Page - 2); number <= Math.Min(Model.TotalPages, Model.Page + 2); number++)
                        {<a class="audit-page-link @(number == Model.Page ? "active" : null)" aria-current="@(number == Model.Page ? "page" : null)" asp-action="Index" asp-route-page="@number" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword" asp-route-group="@selectedGroup" asp-route-outcome="@Model.Outcome" asp-route-authMethod="@Model.AuthMethod">@number</a>}
                        <a class="audit-page-link @(Model.Page >= Model.TotalPages ? "disabled" : null)" aria-label="Trang sau" aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : null)" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword" asp-route-group="@selectedGroup" asp-route-outcome="@Model.Outcome" asp-route-authMethod="@Model.AuthMethod"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
                    </nav>
                }
            </section>
        </main>
    </div>
</section>

<dialog class="audit-dialog" id="auditDetailDialog" aria-labelledby="auditDialogTitle">
    <div class="audit-dialog-shell"><header class="audit-dialog-header"><div><span>Chi tiết nhật ký</span><h2 id="auditDialogTitle">Chi tiết hoạt động</h2></div><button type="button" data-close aria-label="Đóng cửa sổ chi tiết"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header><div class="audit-dialog-body"><section class="audit-meta"><h3><i class="fa-solid fa-circle-info" aria-hidden="true"></i>Thông tin chung</h3><dl id="auditMeta"></dl></section><div class="audit-change-grid"><section id="auditOldSection"><h3><i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>Dữ liệu trước</h3><dl id="auditOldData"></dl></section><section id="auditNewSection"><h3><i class="fa-solid fa-arrow-right" aria-hidden="true"></i>Dữ liệu sau</h3><dl id="auditNewData"></dl></section></div></div></div>
</dialog>

@section Scripts {
<script>
(() => {
    const form = document.getElementById('auditFilterForm');
    const error = document.getElementById('auditFilterError');
    const dialog = document.getElementById('auditDetailDialog');
    const title = document.getElementById('auditDialogTitle');
    const meta = document.getElementById('auditMeta');
    const oldData = document.getElementById('auditOldData');
    const newData = document.getElementById('auditNewData');
    const oldSection = document.getElementById('auditOldSection');
    const newSection = document.getElementById('auditNewSection');
    const labels = { status:'Trạng thái', amount:'Số tiền', price:'Đơn giá', totalAmount:'Tổng tiền', role:'Vai trò', roleName:'Vai trò', reason:'Lý do', rejectionReason:'Lý do từ chối', fullName:'Họ tên', email:'Email', phoneNumber:'Số điện thoại', hallName:'Sảnh', eventDate:'Ngày tổ chức', shift:'Ca', paymentMethod:'Phương thức thanh toán', transactionId:'Mã giao dịch', incidentType:'Loại sự cố', resolution:'Hướng xử lý' };
    const values = { ACTIVE:'Hoạt động', LOCKED:'Bị khóa', PENDING:'Chờ duyệt', APPROVED:'Đã duyệt', REJECTED:'Từ chối', SUCCESS:'Thành công', FAILED:'Thất bại', BLOCKED:'Bị từ chối', true:'Có', false:'Không' };
    const sensitive = ['password','matkhau','token','otp','secret','authorization','salt','securitycode'];
    let opener = null;

    form?.addEventListener('submit', event => {
        const from = form.elements.fromDate?.value;
        const to = form.elements.toDate?.value;
        error.hidden = true;
        if (from && to && to < from) { event.preventDefault(); error.textContent = 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.'; error.hidden = false; }
    });

    const parseAuditValue = raw => {
        if (!raw) return null;
        try { return JSON.parse(raw); } catch {
            const legacy = {};
            raw.split(';').forEach(part => { const index = part.indexOf('='); if (index > 0) legacy[part.slice(0, index).trim()] = part.slice(index + 1).trim(); });
            return Object.keys(legacy).length ? legacy : raw;
        }
    };
    const formatValue = (key, value) => {
        if (value === null || value === undefined || value === '') return '—';
        if (/amount|price|total|fee|refund/i.test(key) && !Number.isNaN(Number(value))) return new Intl.NumberFormat('vi-VN', { style:'currency', currency:'VND', maximumFractionDigits:0 }).format(Number(value));
        return values[String(value)] || String(value);
    };
    const appendValue = (container, key, value) => {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        const normalized = key.replace(/[^a-z0-9]/gi, '').toLowerCase();
        dt.textContent = labels[key] || key.replace(/([a-z])([A-Z])/g, '$1 $2');
        if (sensitive.some(word => normalized.includes(word))) dd.textContent = '[Đã ẩn]';
        else if (value && typeof value === 'object') { const pre = document.createElement('pre'); pre.textContent = JSON.stringify(value, null, 2); dd.append(pre); }
        else dd.textContent = formatValue(key, value);
        container.append(dt, dd);
    };
    const renderData = (container, raw) => {
        container.replaceChildren();
        const parsed = parseAuditValue(raw);
        if (parsed === null) return false;
        if (typeof parsed !== 'object') { const dd = document.createElement('dd'); dd.className = 'audit-legacy-text'; dd.textContent = parsed; container.append(dd); return true; }
        const entries = Object.entries(parsed);
        entries.forEach(([key, value]) => appendValue(container, key, value));
        return entries.length > 0;
    };
    const addMeta = (label, value) => { if (value === null || value === undefined || value === '') return; const dt = document.createElement('dt'); const dd = document.createElement('dd'); dt.textContent = label; dd.textContent = value; meta.append(dt, dd); };

    document.querySelectorAll('.audit-detail-button').forEach(button => button.addEventListener('click', () => {
        const node = document.getElementById(button.dataset.detailId);
        if (!node) return;
        const log = JSON.parse(node.textContent);
        opener = button;
        title.textContent = button.dataset.title || log.Action || 'Chi tiết hoạt động';
        meta.replaceChildren();
        addMeta('Mã nhật ký', log.AuditLogId);
        addMeta('Danh mục', button.dataset.groupLabel || log.Group);
        addMeta('Thời gian', new Date(log.Timestamp).toLocaleString('vi-VN'));
        addMeta('Người thực hiện', log.ActorName || log.Actor);
        addMeta('Vai trò', log.ActorRole);
        addMeta('Nguồn', log.Source);
        addMeta('Hành động', button.dataset.title || log.Action);
        addMeta('Đối tượng', log.Target);
        addMeta('Mã đối tượng', log.EntityName ? `${log.EntityName} #${log.EntityId}` : null);
        addMeta('Phương thức xác thực', log.AuthMethod);
        addMeta('Địa chỉ IP', log.IpAddress);
        addMeta('Thiết bị / trình duyệt', log.UserAgent);
        addMeta('Kết quả', values[log.Outcome] || log.Outcome);
        addMeta('Ghi chú', log.Notes);
        oldSection.hidden = !renderData(oldData, log.OldData);
        newSection.hidden = !renderData(newData, log.NewData);
        dialog.showModal();
    }));
    dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog?.addEventListener('close', () => opener?.focus());
})();
</script>
}
