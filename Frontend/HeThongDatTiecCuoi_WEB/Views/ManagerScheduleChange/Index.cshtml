@model HeThongDatTiecCuoi_WEB.Models.ScheduleChange.ScheduleChangeAdminPageViewModel
@using HeThongDatTiecCuoi_WEB.Models.ScheduleChange
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Phê duyệt thay đổi lịch"; var selected=Model.Selected; }
@section Styles { <link rel="stylesheet" href="~/css/schedule-change-admin.css" asp-append-version="true" /> }
<main class="sca-page"><header class="sca-header"><div><span>Quản lý vận hành</span><h1>Phê duyệt thay đổi lịch</h1><p>Báo giá, theo dõi thanh toán và xử lý đối soát từ dữ liệu Backend.</p></div></header>
@if(ViewBag.Error is string error){<div class="sca-alert error">@error</div>}
<section class="sca-stats"><article><small>Chờ duyệt</small><b>@Model.Items.Count(x=>x.Status=="UNDER_REVIEW")</b></article><article><small>Chờ khách xác nhận</small><b>@Model.Items.Count(x=>x.Status=="AWAITING_QUOTE_ACCEPTANCE")</b></article><article><small>Chờ thanh toán</small><b>@Model.Items.Count(x=>x.Status=="PAYMENT_PENDING")</b></article><article><small>Hoàn tất</small><b>@Model.Items.Count(x=>x.Status=="APPROVED")</b></article><article><small>Cần đối soát</small><b>@Model.Items.Count(x=>x.Status=="RECONCILIATION_REQUIRED")</b></article></section>
<form method="get" class="sca-filter"><input name="search" value="@Model.Search" placeholder="Mã booking hoặc khách hàng"/><select name="status"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"UNDER_REVIEW","AWAITING_QUOTE_ACCEPTANCE","PAYMENT_PENDING","APPROVED","REJECTED","RECONCILIATION_REQUIRED"}){<option value="@s" selected="@(Model.FilterStatus==s)">@ScheduleChangeStatusDisplay.Name(s)</option>}</select><button class="sca-btn">Lọc</button></form>
<div class="sca-layout"><section class="sca-card table"><table><thead><tr><th>Yêu cầu</th><th>Khách hàng</th><th>Lịch cũ → mới</th><th>Phí</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>#@x.ScheduleChangeId</b><small>@x.BookingCode</small></td><td>@x.CustomerName</td><td>@x.OldDate.ToString("dd/MM") @x.OldShift → @x.NewDate.ToString("dd/MM") @x.NewShift<small>@x.OldHallName → @x.NewHallName</small></td><td>@x.AppliedFee.ToString("N0") ₫</td><td><span class="sca-status">@x.DisplayStatus</span></td><td><a asp-action="Index" asp-route-id="@x.ScheduleChangeId" asp-route-status="@Model.FilterStatus" asp-route-search="@Model.Search">Chi tiết</a></td></tr>}</tbody></table></section>
@if(selected is not null){<aside class="sca-card detail"><h2>Yêu cầu #@selected.ScheduleChangeId</h2><dl><dt>Booking / khách</dt><dd>@selected.BookingCode · @selected.CustomerName</dd><dt>Lịch cũ</dt><dd>@selected.OldShift, @selected.OldDate.ToString("dd/MM/yyyy") · @selected.OldHallName</dd><dt>Lịch mới</dt><dd>@selected.NewShift, @selected.NewDate.ToString("dd/MM/yyyy") · @selected.NewHallName</dd><dt>Lý do</dt><dd>@selected.Reason</dd><dt>Kết quả HallManager</dt><dd>@(selected.ReviewResult??"Chưa có")</dd><dt>Ngoại lệ</dt><dd>@(selected.ExceptionReason??"Không")</dd><dt>Chính sách</dt><dd>POL-CHG-05 v@selected.PolicyVersion · @selected.AppliedFee.ToString("N0") ₫</dd></dl>
@if(selected.Quote is not null){<div class="sca-money"><span>Giá sảnh cũ<b>@selected.Quote.OldHallPrice.ToString("N0") ₫</b></span><span>Giá sảnh mới<b>@selected.Quote.NewHallPrice.ToString("N0") ₫</b></span><span>Chênh lệch<b>@selected.Quote.HallPriceDifference.ToString("N0") ₫</b></span><span>Phải thu<b>@selected.Quote.AmountDue.ToString("N0") ₫</b></span><span>Hoàn/giảm dự kiến<b>@Math.Max(selected.Quote.RefundAmount,selected.Quote.CreditAmount).ToString("N0") ₫</b></span></div>}
@if(selected.Status=="UNDER_REVIEW"){<form class="sca-ajax" asp-action="Quote"><input type="hidden" name="id" value="@selected.ScheduleChangeId"/>@Html.AntiForgeryToken()<label>Ghi chú báo giá<textarea name="note" maxlength="1000"></textarea></label><p class="sca-alert">Phụ phí và chênh lệch giá do Backend tính theo chính sách, không thể sửa trên giao diện.</p><button class="sca-btn primary">Lập báo giá và duyệt có điều kiện</button></form><form class="sca-ajax" asp-action="Reject"><input type="hidden" name="id" value="@selected.ScheduleChangeId"/>@Html.AntiForgeryToken()<label>Lý do từ chối<textarea name="reason" minlength="3" required></textarea></label><button class="sca-btn danger">Từ chối</button></form>}
@if(selected.Status=="RECONCILIATION_REQUIRED"){<form class="sca-ajax" asp-action="Reconcile"><input type="hidden" name="id" value="@selected.ScheduleChangeId"/>@Html.AntiForgeryToken()<label>Hướng xử lý<select name="action"><option value="RECHECK">Kiểm tra lại</option><option value="REFUND">Lập hoàn tiền</option><option value="COMPLETE">Hoàn tất nếu hợp lệ</option></select></label><label>Bằng chứng đối soát<textarea name="evidence" minlength="3" required></textarea></label><button class="sca-btn primary">Ghi nhận xử lý</button></form>}
@if(Model.Financials is not null){<details open><summary>Tài chính và PayOS</summary>@foreach(var t in Model.Financials.Transactions){<p class="sca-alert"><b>OrderCode @t.OrderCode</b> · @t.Status<br/>Thực chuyển @t.ActualAmount.ToString("N0") ₫ / nghiệp vụ @t.BusinessAmount.ToString("N0") ₫<br/>@(t.ReconciliationData??"")</p>}@foreach(var r in Model.Financials.Refunds){<form class="sca-ajax" asp-action="ConfirmRefund"><input type="hidden" name="id" value="@selected.ScheduleChangeId"/><input type="hidden" name="refundId" value="@r.RefundId"/>@Html.AntiForgeryToken()<p>Hoàn tiền #@r.RefundId · @r.Amount.ToString("N0") ₫ · @r.Status</p>@if(r.Status!="COMPLETED"){<textarea name="evidence" minlength="3" required placeholder="Chứng từ hoàn tiền thủ công"></textarea><button class="sca-btn">Xác nhận đã hoàn thủ công</button>}</form>}@if(Model.Financials.Amendment is not null){<div class="sca-alert"><b>Phụ lục hợp đồng #@Model.Financials.Amendment.AmendmentId</b><br/>Hiệu lực @Model.Financials.Amendment.EffectiveAt.ToString("dd/MM/yyyy") · @Model.Financials.Amendment.Status<br/>@Model.Financials.Amendment.Content</div>}</details>}
<details><summary>Lịch sử xử lý</summary><ol>@foreach(var h in selected.History){<li>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm") · <b>@ScheduleChangeStatusDisplay.Name(h.ToStatus)</b> · @h.Note</li>}</ol></details></aside>}</div></main>
@section Scripts { <script src="~/js/schedule-change-admin.js" asp-append-version="true"></script> }
