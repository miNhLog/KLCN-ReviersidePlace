@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.Halls.HallListViewModel
@{
    ViewData["Title"] = "Danh sách sảnh";
    ViewData["PublicActivePage"] = "halls";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/home/hall-placeholder.jpg");
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/split-catalog.css" asp-append-version="true" />
}

<div class="home-page split-catalog-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        <nav class="public-breadcrumb" aria-label="Đường dẫn trang">
            <div class="home-container"><a asp-controller="Home" asp-action="Index" asp-route-publicSite="true">Trang chủ</a><span class="public-breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page">Sảnh tiệc</span></div>
        </nav>
        <section aria-labelledby="hall-list-title">
            <header class="sc-intro">
                <img class="sc-banner-photo" src="~/images/home/hero-wedding.jpg" alt="" aria-hidden="true" fetchpriority="high" />
                <span class="sc-kicker">RIVERSIDE PALACE · VENUES</span>
                <h1 id="hall-list-title">Kiệt Tác Sảnh Tiệc <em>Ven Sông</em></h1>
            </header>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="sc-empty home-container" role="alert"><h2>Không thể tải danh sách sảnh</h2><p>Vui lòng thử lại sau.</p><a class="sc-detail" asp-controller="Halls" asp-action="Index">Thử lại</a></div>
            }
            else if (Model.Halls.Count == 0)
            {
                <div class="sc-empty home-container"><h2>Chưa có sảnh tiệc được giới thiệu</h2><p>Thông tin sảnh tiệc sẽ được cập nhật tại đây.</p></div>
            }
            else
            {
                <div class="sc-list">
                    @foreach (var hall in Model.Halls)
                    {
                        var capacity = hall.MinimumCapacity.HasValue && hall.MinimumCapacity.Value > 0
                            ? hall.MinimumCapacity.Value == hall.MaximumCapacity ? $"{hall.MaximumCapacity.ToString("N0", vi)} khách" : $"{hall.MinimumCapacity.Value.ToString("N0", vi)} – {hall.MaximumCapacity.ToString("N0", vi)} khách"
                            : $"Tối đa {hall.MaximumCapacity.ToString("N0", vi)} khách";
                        var image = string.IsNullOrWhiteSpace(hall.ImageUrl) ? placeholderImage : hall.ImageUrl;
                        <article class="sc-row" aria-labelledby="hall-name-@hall.HallId">
                            <div class="home-container sc-row-inner">
                                <div class="sc-copy">
                                    <span class="sc-star" aria-hidden="true">✳</span>
                                    <h2 id="hall-name-@hall.HallId">Sảnh <strong>@hall.HallName</strong></h2>
                                    <div class="sc-rule" aria-hidden="true"></div>
                                    <p>@(string.IsNullOrWhiteSpace(hall.Description) ? "Không gian tiệc cưới sang trọng tại Riverside Palace." : hall.Description)</p>
                                    <div class="sc-meta"><span>@capacity</span><span>Giá thuê: @hall.RentalPrice.ToString("N0", vi) VNĐ</span></div>
                                    <a class="sc-detail" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId" aria-label="Xem chi tiết sảnh @hall.HallName">Chi tiết <span class="material-symbols-outlined" aria-hidden="true">north_east</span></a>
                                </div>
                                <a class="sc-image" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId" aria-label="Xem hình ảnh và chi tiết sảnh @hall.HallName"><img src="@image" alt="Không gian sảnh @hall.HallName" loading="lazy" data-fallback="@placeholderImage" /></a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
}
