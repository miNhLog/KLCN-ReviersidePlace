@model HeThongDatTiecCuoi_WEB.Models.ScheduleChange.ScheduleChangeAdminPageViewModel
@using HeThongDatTiecCuoi_WEB.Models.ScheduleChange
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Thay đổi lịch"; var selected = Model.Selected; }
@section Styles { <link rel="stylesheet" href="~/css/schedule-change-admin.css" asp-append-version="true" /> }
<main class="sca-page">
    <header class="sca-header"><div><span>Vận hành sảnh</span><h1>Thay đổi lịch</h1><p>Tiếp nhận, kiểm tra nghiệp vụ và chuyển kết quả cho Manager.</p></div><button class="sca-btn primary" data-open="hmCreate">Tạo yêu cầu thay khách</button></header>
    @if (ViewBag.Error is string error) { <div class="sca-alert error">@error</div> }
    <section class="sca-stats">
        <article><small>Tổng yêu cầu</small><b>@Model.Items.Count</b></article><article><small>Chờ kiểm tra</small><b>@Model.Items.Count(x=>x.Status=="PENDING")</b></article><article><small>Đang xử lý</small><b>@Model.Items.Count(x=>x.Status is "UNDER_REVIEW" or "AWAITING_QUOTE_ACCEPTANCE" or "PAYMENT_PENDING")</b></article><article><small>Hoàn tất</small><b>@Model.Items.Count(x=>x.Status=="APPROVED")</b></article><article><small>Từ chối</small><b>@Model.Items.Count(x=>x.Status=="REJECTED")</b></article>
    </section>
    <form method="get" class="sca-filter"><input name="search" value="@Model.Search" placeholder="Mã booking hoặc khách hàng"/><select name="status"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"PENDING","UNDER_REVIEW","AWAITING_QUOTE_ACCEPTANCE","PAYMENT_PENDING","APPROVED","REJECTED","CANCELLED","EXPIRED"}){<option value="@s" selected="@(Model.FilterStatus==s)">@ScheduleChangeStatusDisplay.Name(s)</option>}</select><button class="sca-btn">Lọc</button></form>
    <div class="sca-layout"><section class="sca-card table"><table><thead><tr><th>Booking</th><th>Lịch hiện tại</th><th>Lịch đề xuất</th><th>Nguồn</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.BookingCode</b><small>@x.CustomerName</small></td><td>@x.OldShift @x.OldDate.ToString("dd/MM/yyyy")<small>@x.OldHallName</small></td><td>@x.NewShift @x.NewDate.ToString("dd/MM/yyyy")<small>@x.NewHallName</small></td><td>@(x.Source=="CUSTOMER"?"Khách hàng":"HallManager")</td><td><span class="sca-status">@x.DisplayStatus</span></td><td><a asp-action="Index" asp-route-id="@x.ScheduleChangeId" asp-route-status="@Model.FilterStatus" asp-route-search="@Model.Search">Chi tiết</a></td></tr>}</tbody></table></section>
    @if(selected is not null){<aside class="sca-card detail"><h2>Yêu cầu #@selected.ScheduleChangeId</h2><dl><dt>Khách hàng</dt><dd>@selected.CustomerName</dd><dt>Booking</dt><dd>@selected.BookingCode</dd><dt>Lịch cũ</dt><dd>@selected.OldShift, @selected.OldDate.ToString("dd/MM/yyyy") · @selected.OldHallName</dd><dt>Lịch mới</dt><dd>@selected.NewShift, @selected.NewDate.ToString("dd/MM/yyyy") · @selected.NewHallName</dd><dt>Lý do</dt><dd>@selected.Reason</dd><dt>Ngoại lệ</dt><dd>@(selected.ExceptionReason??"Không")</dd><dt>Chính sách</dt><dd>POL-CHG-05 v@selected.PolicyVersion · @selected.AppliedFee.ToString("N0") ₫</dd></dl>@if(selected.Status=="PENDING"){<form class="sca-ajax" asp-action="Review"><input type="hidden" name="id" value="@selected.ScheduleChangeId"/>@Html.AntiForgeryToken()<label>Kết quả kiểm tra<textarea name="reviewResult" minlength="3" maxlength="2000" required placeholder="Khả dụng sảnh, sức chứa, điều phối viên, hợp đồng và nội dung phối hợp..."></textarea></label><button class="sca-btn primary">Chuyển Manager duyệt</button></form>}else{<div class="sca-alert">@(selected.ReviewResult??"Yêu cầu đã qua bước kiểm tra.")</div>}</aside>}</div>
</main>
<div class="sca-modal" id="hmCreate" hidden><div><button class="sca-close">×</button><h2>Tạo yêu cầu thay khách</h2><form class="sca-ajax" asp-action="Create">@Html.AntiForgeryToken()<label>Booking ID<input type="number" name="BookingId" min="1" required/></label><label>Sảnh mới ID<input type="number" name="NewHallId" min="1" required/></label><label>Ngày mới<input type="date" name="NewDate" required/></label><label>Ca<select name="NewShift" required><option>Trưa</option><option>Tối</option></select></label><label>Lý do<textarea name="Reason" minlength="3" maxlength="500" required></textarea></label><label>Giải trình ngoại lệ (nếu dưới 7 ngày)<textarea name="ExceptionReason" maxlength="1000"></textarea></label><label>Bằng chứng khách đồng ý<textarea name="CustomerConsentEvidence" minlength="3" maxlength="2000" required></textarea></label><p class="sca-alert">Yêu cầu này vẫn phải được Manager duyệt. HallManager không thể tự phê duyệt.</p><button class="sca-btn primary">Tạo yêu cầu</button></form></div></div>
@section Scripts { <script src="~/js/schedule-change-admin.js" asp-append-version="true"></script> }
