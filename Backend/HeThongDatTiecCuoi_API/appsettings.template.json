{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=IRiversidePalaceDB;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },
  "Jwt": {
    "Issuer": "RiversidePalace.Api",
    "Audience": "RiversidePalace.Web",
    "Key": "YOUR_STRONG_SECRET_KEY_MIN_32_CHARACTERS_LONG_HERE",
    "AccessTokenMinutes": 60,
    "RememberMeDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7102",
      "http://localhost:5102",
      "https://127.0.0.1:7102",
      "http://127.0.0.1:5102"
    ]
  },
  "PasswordReset": {
    "FrontendBaseUrl": "https://localhost:7102",
    "TokenLifetimeMinutes": 30,
    "CooldownSeconds": 60
  },
  "AccountProvisioning": {
    "DefaultStaffPassword": "YOUR_INITIAL_DEFAULT_STAFF_PASSWORD"
  },
  "AiService": {
    "BaseUrl": "http://ai:8000/",
    "TimeoutSeconds": 5
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Disabled",
    "Endpoint": "",
    "ApiKey": "",
    "ApiKeyHeader": "X-Api-Key",
    "SenderId": "Riverside"
  },
  "PricingPolicy": {
    "OverBudgetToleranceVnd": 10000000,
    "OverBudgetTolerancePercent": 0.05,
    "UseMinTolerance": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "SenderEmail": "",
    "SenderName": "Riverside Palace"
  },
  "MailSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Trung Tâm Hội Nghị Tiệc Cưới Riverside Palace",
    "SenderEmail": "YOUR_SENDER_EMAIL@gmail.com",
    "Password": "YOUR_APP_SPECIFIC_PASSWORD",
    "EnableSsl": true,
    "ClientAppBaseUrl": "https://localhost:7102"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "IsDemoMode": true,
    "DemoScaleRatio": 10000,
    "ReturnUrl": "https://localhost:7102/Payment/Success",
    "CancelUrl": "https://localhost:7102/Payment/Cancel",
    "ScheduleChangeReturnUrl": "https://localhost:7102/ScheduleChange/PaymentResult",
    "ScheduleChangeCancelUrl": "https://localhost:7102/ScheduleChange/PaymentCancelled"
  },
  "AllowedHosts": "*"
}

